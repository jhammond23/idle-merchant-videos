d", 65.669, 65.786], ["took", 65.786, 65.944], ["it", 65.944, 66.019], ["home", 66.019, 66.286], ["grandma", 66.644, 66.953], ["hangs", 66.953, 67.161], ["her", 67.161, 67.228], ["laundry", 67.228, 67.611], ["on", 67.611, 67.728], ["it", 67.728, 67.803], ["now", 67.803, 68.094], ["but", 68.478, 68.611], ["that", 68.611, 68.786], ["night", 68.786, 69.119], ["another", 69.369, 69.694], ["bell", 69.694, 69.927], ["rang", 69.927, 70.261], ["far", 70.411, 70.769], ["past", 70.769, 71.086], ["the", 71.086, 71.144], ["mountains", 71.144, 71.611], ["it", 71.911, 71.994], ["was", 71.994, 72.127], ["bigger", 72.127, 72.427], ["than", 72.427, 72.553], ["ours", 72.553, 72.911], ["and", 73.261, 73.344], ["for", 73.344, 73.419], ["the", 73.419, 73.478], ["first", 73.478, 73.761], ["time", 73.761, 73.953], ["in", 73.953, 74.002], ["my", 74.002, 74.144], ["life", 74.144, 74.528], ["my", 74.744, 74.877], ["knees", 74.877, 75.244], ["bent", 75.244, 75.578], ["do", 75.894, 76.003], ["i", 76.003, 76.102], ["go", 76.102, 76.228], ["find", 76.228, 76.494], ["that", 76.494, 76.628], ["bell", 76.628, 76.978], ["or", 77.144, 77.228], ["stay", 77.228, 77.453], ["away", 77.453, 77.878], ["a", 78.353, 78.703], ["find", 78.936, 79.211], ["it", 79.211, 79.377], ["b", 79.686, 80.103], ["stay", 80.294, 80.544], ["away", 80.544, 80.919], ["follow", 81.244, 81.653], ["if", 81.653, 81.744], ["you'd", 81.744, 81.869], ["have", 81.869, 81.953], ["stood", 81.953, 82.186], ["up", 82.186, 82.336], ["too", 82.336, 82.769]], "lines": [[0.0, 3.325, "In this town, when the king's bell rings, everybody has to kneel."], [3.558, 4.95, "Your knees bend by themselves."], [5.283, 7.992, "Even the king's horse has to kneel. The horse hates it."], [8.392, 10.467, "I'm Fold, and my knees have never bent."], [10.675, 12.542, "I just pretend, so the king won't find out."], [12.925, 16.033, "Today, the king put in his gold earplugs and rang the bell once."], [16.317, 18.678, "He said, \"Stay down until you pay me double.\""], [19.036, 21.586, "My grandma's knees are bad. She started to shake."], [21.869, 22.611, "So I stood up."], [22.994, 26.136, "A thousand people were on their knees, and one kid was standing."], [26.453, 28.466, "The king screamed, \"Guards! Grab him!\""], [28.749, 30.058, "But the guards were kneeling too."], [30.316, 32.793, "One said, \"We'd love to, Your Majesty.\""], [33.144, 35.586, "So I walked to the bell tower. Nobody could stop me."], [35.853, 37.419, "The king ran up the stairs behind me."], [37.786, 39.186, "At the top, I had a choice."], [39.511, 42.369, "Two rings lets everyone stand up, so I could ring it twice."], [42.602, 44.303, "But tomorrow, he'd just ring it again."], [44.678, 46.219, "So I pulled the plugs out of his ears."], [46.411, 47.669, "Then I rang the bell."], [47.994, 49.111, "The king's knees bent."], [49.336, 51.744, "He knelt on his own tower, in front of his whole town."], [52.036, 54.178, "I said, \"Stay down until you say sorry.\""], [54.461, 56.044, "He said it. He said it loud."], [56.328, 58.786, "Then I rang it twice, and a thousand people stood up."], [59.194, 60.428, "I helped Grandma up first."], [60.686, 64.293, "She hugged me and said, \"Nobody decides when you bend but you.\""], [64.719, 66.286, "I cut the bell rope and took it home."], [66.644, 68.094, "Grandma hangs her laundry on it now."], [68.478, 71.611, "But that night, another bell rang, far past the mountains."], [71.911, 72.911, "It was bigger than ours."], [73.261, 75.578, "And for the first time in my life, my knees bent."], [75.894, 80.919, "Do I go find that bell, or stay away? A, find it. B, stay away."], [81.244, 82.769, "Follow if you'd have stood up too."]]}