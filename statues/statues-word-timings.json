o", 66.673, 66.79], ["the", 66.79, 66.898], ["roof", 66.898, 67.257], ["the", 67.49, 67.59], ["king", 67.59, 67.823], ["shouted", 67.823, 68.215], ["i", 68.44, 68.608], ["am", 68.608, 68.749], ["still", 68.749, 69.1], ["your", 69.1, 69.267], ["king", 69.267, 69.702], ["every", 70.06, 70.335], ["statue", 70.335, 70.818], ["blinked", 70.818, 71.102], ["again", 71.102, 71.468], ["even", 71.668, 71.893], ["his", 71.893, 72.052], ["own", 72.052, 72.36], ["so", 72.585, 72.743], ["i", 72.743, 72.877], ["asked", 72.877, 73.227], ["then", 73.477, 73.61], ["who", 73.61, 73.818], ["is", 73.818, 74.168], ["a", 74.585, 74.66], ["hundred", 74.66, 75.118], ["stone", 75.118, 75.518], ["heads", 75.518, 75.843], ["turned", 75.843, 76.277], ["and", 76.427, 76.535], ["looked", 76.535, 76.768], ["at", 76.768, 76.852], ["the", 76.852, 76.918], ["same", 76.918, 77.31], ["person", 77.31, 77.76], ["it", 78.085, 78.16], ["was", 78.16, 78.31], ["mara", 78.31, 78.735], ["the", 78.918, 79.018], ["old", 79.018, 79.235], ["woman", 79.235, 79.468], ["who", 79.468, 79.577], ["sells", 79.577, 79.868], ["bread", 79.868, 80.26], ["she", 80.552, 80.668], ["shook", 80.668, 80.868], ["her", 80.868, 80.968], ["head", 80.968, 81.135], ["at", 81.135, 81.227], ["me", 81.227, 81.377], ["and", 81.377, 81.452], ["whispered", 81.452, 81.843], ["don't", 82.143, 82.52], ["do", 82.895, 83.012], ["i", 83.012, 83.103], ["tell", 83.103, 83.295], ["the", 83.295, 83.37], ["town", 83.37, 83.762], ["or", 83.895, 83.978], ["keep", 83.978, 84.178], ["her", 84.178, 84.262], ["secret", 84.262, 84.728], ["a", 85.103, 85.42], ["tell", 85.628, 85.853], ["them", 85.853, 86.028], ["b", 86.303, 86.695], ["keep", 86.828, 87.045], ["it", 87.045, 87.32]], "lines": [[0.0, 2.792, "In this town, the statues blink when somebody lies."], [3.15, 5.233, "The king hates them. He lies a lot."], [5.583, 9.008, "I'm Fold, and I got the king to lie to a hundred statues at once."], [9.35, 11.217, "It started when the prince pushed me in the fountain."], [11.467, 12.858, "He said, \"I never touched him.\""], [13.192, 14.758, "The stone knight behind him blinked."], [14.933, 16.967, "Everybody saw it, and everybody laughed."], [17.35, 21.44, "The next day, the king said, \"My grain house is empty, so I'm taking your bread.\""], [21.84, 23.89, "He said it indoors, where there are no statues."], [24.232, 27.223, "Then he sent men with hammers to smash every statue in the square."], [27.632, 29.123, "The first one in line was my mom's."], [29.457, 32.732, "She pulled six kids out of a fire, so the town carved her in stone."], [33.157, 34.298, "I stood in front of the hammer."], [34.498, 36.243, "The man said, \"Move, kid.\""], [36.543, 38.01, "I said, \"I'm not scared of you.\""], [38.377, 40.352, "Behind me, my mom's statue blinked."], [40.743, 43.643, "I was lying. I was very scared. I stayed anyway."], [44.052, 45.535, "Then people started standing next to me."], [45.785, 47.96, "One, then ten, then the whole square."], [48.327, 49.827, "The king came out to see what was wrong."], [50.077, 52.235, "Now he was standing in front of a hundred statues."], [52.51, 55.11, "So I asked him, loud, \"Is the grain house empty?\""], [55.527, 57.543, "He looked at the statues. He looked at the crowd."], [57.802, 59.048, "He said, \"Yes.\""], [59.465, 61.348, "A hundred statues blinked at once."], [61.607, 63.457, "It sounded like a hundred doors closing."], [63.757, 65.765, "The baker yelled, \"Open the grain house!\""], [66.057, 67.257, "It was full to the roof."], [67.49, 69.702, "The king shouted, \"I am still your king!\""], [70.06, 72.36, "Every statue blinked again. Even his own."], [72.585, 74.168, "So I asked, \"Then who is?\""], [74.585, 77.76, "A hundred stone heads turned, and looked at the same person."], [78.085, 80.26, "It was Mara, the old woman who sells bread."], [80.552, 82.52, "She shook her head at me and whispered, \"Don't.\""], [82.895, 87.32, "Do I tell the town, or keep her secret? A, tell them. B, keep it."]]}