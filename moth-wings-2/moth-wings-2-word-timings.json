05], ["holes", 63.905, 64.292], ["in", 64.292, 64.38], ["the", 64.38, 64.442], ["lid", 64.442, 64.776], ["this", 65.005, 65.199], ["time", 65.199, 65.48], ["the", 65.656, 65.761], ["whole", 65.761, 66.096], ["square", 66.096, 66.5], ["laughed", 66.5, 66.896], ["at", 66.896, 67.037], ["him", 67.037, 67.204], ["then", 67.435, 67.611], ["the", 67.611, 67.672], ["fog", 67.672, 68.077], ["behind", 68.077, 68.455], ["me", 68.455, 68.561], ["started", 68.561, 68.895], ["to", 68.895, 68.965], ["glow", 68.965, 69.449], ["thousands", 69.642, 70.214], ["of", 70.214, 70.293], ["moths", 70.293, 70.75], ["were", 70.75, 70.891], ["rising", 70.891, 71.384], ["out", 71.384, 71.489], ["of", 71.489, 71.568], ["the", 71.568, 71.621], ["forest", 71.621, 72.105], ["and", 72.298, 72.395], ["they", 72.395, 72.457], ["were", 72.457, 72.632], ["all", 72.632, 72.87], ["flying", 72.87, 73.266], ["straight", 73.266, 73.661], ["at", 73.661, 73.855], ["me", 73.855, 73.985]], "lines": [[0.0, 5.101, "In this town, every kid grows wings, and yesterday my tiny moth wings blocked out the sun."], [5.302, 8.064, "So this morning, the duke banned moths from the sky."], [8.284, 11.504, "His griffin wings are the biggest in the kingdom. His ego is bigger."], [11.504, 17.65, "He handed me a jar and said, \"Moths belong in jars.\" It had holes in the lid. He thought that was generous."], [17.853, 19.208, "The whole square laughed."], [19.519, 24.981, "That afternoon, while forty kids were flying home, a fog rolled in so thick you couldn't see your own hands."], [25.206, 31.766, "The griffin kids flew in circles. The eagle kids flew into trees. One sparrow kid landed on a cow and refused to get off."], [31.98, 36.322, "Even the duke got lost. We could hear him yelling \"I'm the duke!\" at a mountain."], [36.571, 41.345, "Then I heard crying in the fog. It was the first-year I saved yesterday, and she's scared of the dark."], [41.583, 43.792, "So I broke the duke's law. I jumped."], [44.006, 47.287, "My wings opened, and the two spots on them lit up like lanterns."], [47.542, 51.631, "I found her clinging to a branch. She grabbed my hand and whispered, \"You're glowing.\""], [51.944, 54.867, "Griffins are made for the sun. Moths are made for the dark."], [55.153, 59.006, "Every lost kid saw my light, and one by one, they followed us home."], [59.251, 62.074, "The last one out of the fog was the duke, covered in leaves."], [62.282, 64.776, "So I gave him back his jar. With holes in the lid."], [65.005, 67.204, "This time, the whole square laughed at him."], [67.435, 69.449, "Then the fog behind me started to glow."], [69.642, 73.985, "Thousands of moths were rising out of the forest, and they were all flying straight at me."]]}