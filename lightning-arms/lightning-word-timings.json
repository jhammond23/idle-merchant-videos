82.975, 83.124], ["his", 83.124, 83.28], ["own", 83.28, 83.436], ["law", 83.436, 83.812], ["the", 84.007, 84.093], ["town", 84.093, 84.429], ["pulled", 84.429, 84.687], ["off", 84.687, 84.859], ["his", 84.859, 85.047], ["iron", 85.047, 85.352], ["crown", 85.352, 85.782], ["and", 85.782, 85.93], ["laid", 85.93, 86.149], ["it", 86.149, 86.235], ["at", 86.235, 86.329], ["my", 86.329, 86.462], ["feet", 86.462, 86.814], ["then", 87.021, 87.302], ["the", 87.302, 87.365], ["gate", 87.365, 87.599], ["of", 87.599, 87.693], ["oaths", 87.693, 88.147], ["shook", 88.147, 88.537], ["because", 88.662, 88.889], ["someone", 88.889, 89.233], ["had", 89.233, 89.358], ["tried", 89.358, 89.585], ["to", 89.585, 89.647], ["break", 89.647, 89.905], ["its", 89.905, 90.046], ["oath", 90.046, 90.39], ["it", 90.578, 90.687], ["stood", 90.687, 90.922], ["up", 90.922, 91.047], ["on", 91.047, 91.164], ["legs", 91.164, 91.555], ["and", 91.555, 91.649], ["arms", 91.649, 92.04], ["made", 92.04, 92.18], ["of", 92.18, 92.266], ["every", 92.266, 92.696], ["arm", 92.696, 93.009], ["it", 93.009, 93.119], ["ever", 93.119, 93.322], ["kept", 93.322, 93.682], ["it", 93.874, 93.999], ["towered", 93.999, 94.453], ["over", 94.453, 94.593], ["the", 94.593, 94.672], ["castle", 94.672, 95.125], ["the", 95.284, 95.354], ["war", 95.354, 95.589], ["beast", 95.589, 95.925], ["turned", 95.925, 96.347], ["and", 96.347, 96.472], ["bowed", 96.472, 96.793], ["to", 96.793, 96.965], ["it", 96.965, 97.074], ["and", 97.25, 97.367], ["a", 97.367, 97.406], ["number", 97.406, 97.742], ["began", 97.742, 98.016], ["to", 98.016, 98.086], ["burn", 98.086, 98.407], ["over", 98.407, 98.618], ["its", 98.618, 98.728], ["head", 98.728, 99.017], ["what's", 99.261, 99.441], ["the", 99.441, 99.519], ["number", 99.519, 99.839], ["over", 99.839, 99.964], ["the", 99.964, 100.043], ["gate", 100.043, 100.387], ["guess", 100.592, 101.077]], "lines": [[0.0, 3.91, "In this town, every kid trades their arms once at the Gate of Oaths, forever."], [4.182, 9.17, "The gate keeps your old arms in its stone and burns a number on your wrists: how rare your new ones are."], [9.432, 11.508, "Half the kids get stone arms. One in two."], [11.742, 14.329, "I traded mine for lightning. One in ten million."], [14.541, 19.194, "But the Warlord who rules our town has a law: the rarest arms in town wear the iron crown."], [19.42, 23.049, "His iron arms were one in a million. So my lightning would take his crown."], [23.253, 27.799, "He couldn't steal my arms. The gate's chains grab anyone who tries and turn their arms to stone."], [28.005, 30.679, "And if anyone tries, they say the gate itself wakes up."], [30.894, 36.258, "So he chained my little sister to his war beast, a horned giant that kneels only to the rarest arms in sight."], [36.479, 40.435, "That morning, he rode to my door. \"Leave by midnight, or she gets dragged away.\""], [40.67, 44.554, "\"Your beast kneels to me,\" I said, and my sparks shoved him back a step."], [44.813, 48.511, "At midnight, I stood at the Gate of Oaths, and the whole town came with torches."], [48.729, 51.692, "The Warlord rode up with his beast, my sister chained behind it."], [51.912, 54.563, "\"Then it drags you both,\" he said, and let it charge."], [54.778, 57.773, "So I raised my arms, and lightning split the ground in front of it."], [57.955, 61.39, "The beast skidded. Then it knelt to me, and the whole town went quiet."], [61.597, 64.106, "Its chains went slack, and my sister ran free."], [64.287, 66.717, "The Warlord jumped down. \"Those arms are mine!\""], [66.966, 68.991, "He grabbed my wrists to tear the lightning off."], [69.205, 73.263, "So the gate's chains snapped around his wrists, and his iron arms turned to stone."], [73.47, 76.722, "The whole town laughed. Stone arms. One in two."], [76.944, 78.922, "\"Kneel to me!\" he roared at his beast."], [79.098, 82.656, "But it stayed kneeling to me. Mine were still the rarest arms in sight."], [82.85, 86.814, "So by his own law, the town pulled off his iron crown and laid it at my feet."], [87.021, 90.39, "Then the Gate of Oaths shook, because someone had tried to break its oath."], [90.578, 93.682, "It stood up on legs and arms made of every arm it ever kept."], [93.874, 95.125, "It towered over the castle."], [95.284, 97.074, "The war beast turned and bowed to it."], [97.25, 99.017, "And a number began to burn over its head."], [99.261, 101.077, "What's the number over the gate? Guess."]]}