143, 67.218], ["fox", 67.218, 67.658], ["can", 67.658, 67.808], ["steal", 67.808, 68.154], ["its", 68.154, 68.294], ["fire", 68.294, 68.716], ["the", 68.943, 69.027], ["dragon", 69.027, 69.43], ["comes", 69.43, 69.664], ["saturday", 69.664, 70.216], ["which", 70.383, 70.561], ["one", 70.561, 70.814], ["joins", 70.814, 71.123], ["my", 71.123, 71.31], ["army", 71.31, 71.685], ["comment", 71.866, 72.259], ["bear", 72.259, 72.774], ["or", 72.858, 72.961], ["fox", 72.961, 73.57]], "lines": [[0.0, 3.577, "In this town, the king's dragon takes one kid every winter."], [3.84, 5.329, "This year, it picked me."], [5.524, 6.722, "Everyone told me to run."], [6.965, 8.548, "I hatched an army instead."], [8.845, 11.438, "Every kid in town gets an egg on their tenth birthday."], [11.642, 13.599, "Most hatch a lizard the size of a shoe."], [13.871, 17.129, "The mayor's son got a hawk, and he hasn't shut up about it since."], [17.461, 19.549, "My egg sat in the window for a year."], [19.731, 20.265, "Cold."], [20.516, 21.593, "Kids called it a rock."], [21.833, 23.715, "This morning, it cracked down the middle."], [23.956, 27.224, "Out stepped a bear made of stone, taller than the castle gate."], [27.443, 30.393, "Then a fox made of smoke, with eyes like lanterns."], [30.623, 32.224, "The whole square went silent."], [32.474, 36.566, "Then every lizard in town crawled out of every pocket and lined up behind me."], [36.767, 39.857, "The mayor's son's hawk flew off his arm and landed on my shoulder."], [40.137, 42.796, "At noon, forty knights rode in to take my egg."], [42.997, 46.251, "The captain pointed his lance at me and said, \"Hand it over, boy.\""], [46.524, 47.461, "The bear stood up."], [47.673, 49.499, "Its shadow covered the whole square."], [49.727, 53.116, "The fox circled the knights once, and their war hawks left them too."], [53.325, 54.86, "Every one of them flew to me."], [55.021, 56.884, "The knights rode home with empty arms."], [57.134, 58.848, "Up on his balcony, the king watched."], [59.072, 60.112, "He didn't say a word."], [60.283, 61.276, "He just went pale."], [61.54, 63.366, "But tonight, the egg went dim."], [63.604, 65.083, "It only has fire for one."], [65.345, 66.955, "The bear can hold a dragon down."], [67.143, 68.716, "The fox can steal its fire."], [68.943, 70.216, "The dragon comes Saturday."], [70.383, 71.685, "Which one joins my army?"], [71.866, 73.57, "Comment BEAR or FOX."]]}