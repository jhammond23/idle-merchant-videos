, 90.289, 90.331], ["river", 90.331, 90.589], ["for", 90.589, 90.706], ["your", 90.706, 90.814], ["mom", 90.814, 91.222]], "lines": [[0.067, 2.45, "In this town, the river won't let anyone cross."], [2.692, 5.4, "So the king built a bridge. Everyone pays him to cross it."], [5.667, 6.508, "Even the ducks."], [6.95, 8.383, "I'm Finn. I didn't pay."], [8.658, 10.858, "I walked across, and the river bowed to me."], [11.35, 13.458, "This morning, the king's soldiers took my mom."], [13.783, 16.183, "She couldn't pay the toll. So they locked her in the castle."], [16.608, 18.025, "I walked straight into the river."], [18.292, 19.325, "It split in half."], [19.692, 22.142, "And inside the water, a face opened its eyes."], [22.417, 25.208, "A giant made of water rose up, taller than the castle."], [25.625, 26.633, "And he bowed to me."], [27.108, 28.85, "The whole town froze on the riverbank."], [29.108, 32.91, "The king ran onto his bridge and screamed, \"Nobody crosses without paying!\""], [33.36, 34.877, "So the giant picked up the bridge."], [35.135, 36.152, "The king was still on it."], [36.477, 39.693, "I said, \"Relax, Your Majesty. It's all water under the bridge.\""], [40.068, 41.485, "The giant dropped him in the river."], [41.752, 43.402, "The river spun him around like a duck."], [43.66, 44.952, "Then it spat him out in the mud."], [45.218, 47.252, "His soldiers dropped their spears and ran."], [47.693, 49.327, "The giant reached over the castle wall."], [49.61, 51.743, "He lifted Mom out, like a bird from a nest."], [52.01, 53.36, "He set her down right next to me."], [53.752, 56.268, "Then the whole town walked across the riverbed behind us."], [56.61, 58.452, "Nobody paid. Not even the ducks."], [58.918, 60.643, "Mom found me in a basket on that river."], [60.985, 61.943, "I was one day old."], [62.243, 63.71, "She raised me all by herself."], [64.127, 66.178, "The giant looked at her and said, \"Thank you.\""], [66.662, 69.202, "\"For twelve years, I let no one cross.\""], [69.66, 71.706, "\"I was waiting for the sea's son to come home.\""], [72.164, 73.513, "\"You kept him safe for us.\""], [73.928, 74.662, "Mom cried."], [74.987, 77.237, "I didn't know rivers could cry. This one did."], [77.72, 79.778, "Then the giant looked down the river, toward the sea."], [80.229, 82.579, "\"The sea is coming for his son,\" he said."], [82.905, 84.782, "\"And the sea is a lot bigger than me.\""], [85.256, 89.123, "Do I go to the sea? A, go. B, stay with Mom."], [89.422, 91.222, "Follow if you'd cross a river for your mom."]]}