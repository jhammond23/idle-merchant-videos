he", 71.439, 71.489], ["square", 71.489, 71.931], ["my", 72.172, 72.281], ["cloud", 72.281, 72.672], ["right", 72.672, 72.848], ["above", 72.848, 73.089], ["it", 73.089, 73.223], ["and", 73.422, 73.597], ["under", 73.597, 73.864], ["it", 73.864, 73.972], ["the", 74.123, 74.206], ["king's", 74.206, 74.556], ["crossbow", 74.556, 75.123], ["the", 75.414, 75.481], ["bolt", 75.481, 75.781], ["was", 75.781, 75.956], ["taller", 75.956, 76.289], ["than", 76.289, 76.414], ["a", 76.414, 76.456], ["house", 76.456, 76.856], ["nell", 77.148, 77.448], ["broke", 77.448, 77.681], ["through", 77.681, 77.831], ["the", 77.831, 77.898], ["guards", 77.898, 78.448], ["she", 78.448, 78.606], ["threw", 78.606, 78.839], ["three", 78.839, 79.131], ["pebbles", 79.131, 79.581], ["anybody", 79.847, 80.321], ["home", 80.321, 80.83], ["nothing", 81.205, 81.622], ["the", 81.997, 82.055], ["crossbow", 82.055, 82.455], ["fired", 82.455, 82.863], ["the", 83.038, 83.122], ["crack", 83.122, 83.405], ["broke", 83.405, 83.68], ["every", 83.68, 83.947], ["window", 83.947, 84.255], ["on", 84.255, 84.372], ["the", 84.372, 84.422], ["square", 84.422, 84.855], ["and", 85.138, 85.313], ["then", 85.313, 85.605], ["the", 85.93, 85.997], ["bolt", 85.997, 86.38], ["came", 86.38, 86.622], ["back", 86.622, 86.847], ["down", 86.847, 87.197], ["in", 87.463, 87.58], ["pieces", 87.58, 88.105], ["my", 88.447, 88.555], ["cloud", 88.555, 88.913], ["didn't", 88.913, 89.088], ["have", 89.088, 89.205], ["a", 89.205, 89.247], ["hole", 89.247, 89.572], ["in", 89.572, 89.655], ["it", 89.655, 89.813], ["nobody", 90.222, 90.58], ["moved", 90.58, 91.022], ["then", 91.447, 91.738], ["from", 91.888, 92.038], ["inside", 92.038, 92.48], ["the", 92.48, 92.538], ["cloud", 92.538, 92.955], ["boom", 93.263, 93.938], ["boom", 94.247, 94.83], ["boom", 95.138, 95.822], ["up", 95.822, 95.938], ["on", 96.405, 96.513], ["the", 96.513, 96.58], ["castle", 96.58, 96.93], ["wall", 96.93, 97.23], ["the", 97.397, 97.455], ["king's", 97.455, 97.78], ["dragon", 97.78, 98.147], ["dropped", 98.147, 98.413], ["flat", 98.413, 98.722], ["on", 98.722, 98.813], ["its", 98.813, 98.938], ["belly", 98.938, 99.305], ["and", 99.555, 99.647], ["the", 99.647, 99.697], ["king", 99.697, 99.988], ["whispered", 99.988, 100.347], ["not", 100.597, 100.841], ["another", 100.841, 101.207], ["one", 101.207, 101.516], ["what", 101.983, 102.066], ["do", 102.066, 102.116], ["you", 102.116, 102.191], ["think", 102.191, 102.374], ["is", 102.374, 102.483], ["up", 102.483, 102.616], ["there", 102.616, 102.916]], "lines": [[0.0, 4.542, "In this town, every kid gets a cloud. Tomorrow at noon, the king shoots mine down."], [5.242, 9.617, "When your cloud opens, your creature climbs down. See the numbers? That's how long each one took."], [10.092, 12.067, "The baker's kid got a wolf. One day."], [12.517, 14.667, "My little sister, Nell, got a hawk. One day."], [15.058, 17.183, "The mayor's son got a griffin. One month."], [17.533, 21.425, "And the king's dragon took one whole year. The longest cloud in history."], [21.808, 24.992, "And yeah. You spotted me already. The kid getting rained on."], [25.258, 28.183, "That's my cloud. Ten years. Still counting."], [28.708, 29.983, "You're thinking: it's empty."], [30.317, 32.658, "So does the whole town. They call me Rain Boy."], [33.05, 37.464, "Everyone except Nell. Every morning, she throws three pebbles up at it. \"Anybody home?\""], [37.889, 38.823, "Nobody ever is."], [39.264, 44.689, "And here's the law. A cloud still shut on your tenth birthday gets shot down. In the square. At noon."], [45.048, 46.123, "I turn ten tomorrow."], [46.464, 48.481, "But hold on. You're doing the math right now."], [48.764, 52.322, "One day for a wolf. One month for a griffin. One year for a dragon."], [52.681, 53.839, "So what takes ten?"], [54.297, 56.164, "In this town, you're not allowed to ask that."], [56.714, 62.114, "That night, my cloud stopped raining. For the first time in ten years. Something was awake up there."], [62.498, 66.314, "So at sunrise, I ran. Rooftops. The bridge. Twenty guards behind me."], [66.656, 68.306, "It's hard to hide when you bring your own weather."], [68.722, 69.631, "They caught me at the river."], [69.948, 73.223, "Noon. The whole town in the square. My cloud right above it."], [73.422, 76.856, "And under it, the king's crossbow. The bolt was taller than a house."], [77.148, 80.83, "Nell broke through the guards. She threw three pebbles. \"Anybody home?\""], [81.205, 81.622, "Nothing."], [81.997, 82.863, "The crossbow fired."], [83.038, 84.855, "The crack broke every window on the square."], [85.138, 88.105, "And then... the bolt came back down. In pieces."], [88.447, 89.813, "My cloud didn't have a hole in it."], [90.222, 91.022, "Nobody moved."], [91.447, 92.955, "Then, from inside the cloud..."], [93.263, 95.822, "Boom... boom... boom."], [95.822, 99.305, "Up on the castle wall, the king's dragon dropped flat on its belly."], [99.555, 101.516, "And the king whispered: \"Not another one.\""], [101.983, 102.916, "What do you think is up there?"]]}