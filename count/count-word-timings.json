 78.95, 79.211], ["one", 79.211, 79.369], ["counted", 79.369, 79.701], ["goes", 79.701, 79.923], ["outside", 79.923, 80.326], ["the", 80.326, 80.374], ["wall", 80.374, 80.769], ["it", 80.963, 81.05], ["took", 81.05, 81.193], ["forty", 81.193, 81.541], ["of", 81.541, 81.612], ["us", 81.612, 81.731], ["to", 81.731, 81.802], ["push", 81.802, 82.047], ["him", 82.047, 82.134], ["through", 82.134, 82.277], ["the", 82.277, 82.34], ["gate", 82.34, 82.633], ["he", 82.777, 82.857], ["was", 82.857, 83.015], ["very", 83.015, 83.331], ["heavy", 83.331, 83.64], ["and", 83.766, 83.853], ["he", 83.853, 83.909], ["was", 83.909, 84.035], ["not", 84.035, 84.296], ["shaped", 84.296, 84.565], ["like", 84.565, 84.692], ["a", 84.692, 84.739], ["man", 84.739, 85.056], ["under", 85.056, 85.19], ["that", 85.19, 85.349], ["coat", 85.349, 85.657], ["we", 85.822, 85.941], ["locked", 85.941, 86.233], ["it", 86.233, 86.36], ["the", 86.517, 86.604], ["gate", 86.604, 86.802], ["was", 86.802, 86.944], ["open", 86.944, 87.158], ["for", 87.158, 87.268], ["fifty", 87.268, 87.601], ["one", 87.601, 87.806], ["seconds", 87.806, 88.242], ["i", 88.416, 88.503], ["counted", 88.503, 88.882], ["then", 89.051, 89.177], ["i", 89.177, 89.249], ["gave", 89.249, 89.438], ["the", 89.438, 89.51], ["blanket", 89.51, 89.818], ["back", 89.818, 90.135], ["then", 90.345, 90.488], ["something", 90.488, 90.828], ["knocked", 90.828, 91.208], ["three", 91.342, 91.587], ["times", 91.587, 91.998], ["very", 92.172, 92.386], ["politely", 92.386, 92.869], ["and", 93.035, 93.138], ["mrs", 93.138, 93.375], ["pell's", 93.375, 93.676], ["voice", 93.676, 93.889], ["said", 93.889, 94.143], ["let", 94.335, 94.446], ["me", 94.446, 94.604], ["in", 94.604, 94.747], ["dear", 94.747, 95.032], ["it's", 95.198, 95.34], ["cold", 95.34, 95.831], ["nobody", 96.034, 96.367], ["opened", 96.367, 96.596], ["it", 96.596, 96.731], ["that", 96.919, 97.101], ["night", 97.101, 97.33], ["i", 97.33, 97.425], ["counted", 97.425, 97.757], ["us", 97.757, 97.971], ["the", 98.105, 98.161], ["way", 98.161, 98.311], ["i", 98.311, 98.414], ["always", 98.414, 98.825], ["do", 98.825, 99.055], ["two", 99.192, 99.422], ["hundred", 99.422, 99.778], ["perfect", 99.947, 100.343], ["then", 100.532, 100.683], ["i", 100.683, 100.762], ["counted", 100.762, 101.055], ["shadows", 101.055, 101.569], ["i'd", 101.746, 101.864], ["never", 101.864, 102.015], ["thought", 102.015, 102.26], ["to", 102.26, 102.466], ["before", 102.466, 102.711], ["today", 102.711, 103.13], ["one", 103.347, 103.45], ["hundred", 103.45, 103.75], ["and", 103.75, 103.877], ["ninety", 103.877, 104.138], ["nine", 104.138, 104.565], ["mabel", 104.861, 105.114], ["was", 105.114, 105.249], ["right", 105.249, 105.415], ["next", 105.415, 105.629], ["to", 105.629, 105.708], ["me", 105.708, 105.874], ["in", 106.0, 106.087], ["the", 106.087, 106.151], ["lamplight", 106.151, 106.633], ["holding", 106.768, 107.029], ["my", 107.029, 107.171], ["hand", 107.171, 107.551], ["so", 107.726, 107.869], ["i", 107.869, 107.924], ["counted", 107.924, 108.233], ["her", 108.233, 108.32], ["freckles", 108.32, 108.786], ["sixty", 108.972, 109.498]], "lines": [[0.0, 6.852, "In this town, the night guard counts us every sunset. Yesterday there were two hundred of us. Tonight he counted two hundred and one, and he's looking at me."], [7.09, 12.792, "Nothing outside can climb our wall. But a long time ago, something walked in through the gate, wearing somebody's face. So we count."], [12.979, 17.095, "The rule is simple. One too many, and the last one counted goes outside the wall until morning."], [17.304, 18.989, "Nobody who went out has ever come back in."], [19.2, 22.541, "Last winter it was old Mrs. Pell. She walked out with a blanket and a sandwich."], [22.781, 24.546, "Tonight, somebody handed me a blanket."], [24.761, 28.488, "The guard is Captain Brill. He counts on his fingers. Twice he's had to take his boots off."], [28.683, 33.083, "And somehow, the last one he counts is always from the poor end of town. I live at the poor end."], [33.233, 40.278, "But my name is Tam, and I count everything. Stairs. Peas. My best friend Mabel's freckles. Sixty one. Always sixty one."], [40.46, 45.443, "And tonight I counted us. Two hundred. I counted again. I always count again. Two hundred."], [45.635, 47.777, "So Brill wasn't miscounting. He was choosing."], [47.953, 49.005, "I said, \"Count again.\""], [49.171, 50.58, "He said, \"I never miscount.\""], [50.763, 54.024, "I said, \"Then count yourself.\" And I pointed at him. \"Two hundred and one.\""], [54.265, 58.097, "The whole square went quiet. In my whole life, nobody had ever counted the captain."], [58.302, 60.011, "Brill smiled. \"I'm the guard, boy.\""], [60.27, 61.776, "I said, \"Then come out of the shade.\""], [61.934, 66.942, "Because I count that too. Every sunset of my life, he has stood in the shadow of the gate. Every single one."], [67.179, 68.766, "Everybody looked at him. He stepped out."], [68.919, 72.013, "The sun was low. Every one of us had a shadow as long as a street."], [72.216, 74.091, "Captain Brill had nothing under his boots."], [74.331, 77.611, "He stopped smiling. His face slid a little, like a hat that doesn't fit."], [77.796, 80.769, "The rule is the rule. The last one counted goes outside the wall."], [80.963, 85.657, "It took forty of us to push him through the gate. He was very heavy, and he was not shaped like a man under that coat."], [85.822, 90.135, "We locked it. The gate was open for fifty one seconds. I counted. Then I gave the blanket back."], [90.345, 92.869, "Then something knocked. Three times, very politely."], [93.035, 95.831, "And Mrs. Pell's voice said, \"Let me in, dear. It's cold.\""], [96.034, 96.731, "Nobody opened it."], [96.919, 100.343, "That night I counted us, the way I always do. Two hundred. Perfect."], [100.532, 103.13, "Then I counted shadows. I'd never thought to, before today."], [103.347, 104.565, "One hundred and ninety nine."], [104.861, 107.551, "Mabel was right next to me, in the lamplight, holding my hand."], [107.726, 108.786, "So I counted her freckles."], [108.972, 109.498, "Sixty."]]}