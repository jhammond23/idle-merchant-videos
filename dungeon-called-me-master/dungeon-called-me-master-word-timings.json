ho", 88.763, 88.845], ["was", 88.845, 88.99], ["kind", 88.99, 89.327], ["to", 89.327, 89.472], ["it", 89.472, 89.526], ["in", 89.526, 89.617], ["the", 89.617, 89.69], ["dark", 89.69, 90.108], ["the", 90.388, 90.479], ["next", 90.479, 90.715], ["morning", 90.715, 91.078], ["the", 91.287, 91.378], ["prince", 91.378, 91.687], ["knocked", 91.687, 91.987], ["on", 91.987, 92.077], ["my", 92.077, 92.241], ["door", 92.241, 92.568], ["and", 92.568, 92.659], ["asked", 92.659, 93.004], ["if", 93.004, 93.122], ["i", 93.122, 93.204], ["needed", 93.204, 93.467], ["someone", 93.467, 93.767], ["to", 93.767, 93.83], ["carry", 93.83, 94.112], ["my", 94.112, 94.257], ["torches", 94.257, 94.829], ["i", 95.1, 95.218], ["told", 95.218, 95.454], ["him", 95.454, 95.554], ["i'd", 95.554, 95.699], ["think", 95.699, 95.899], ["about", 95.899, 96.172], ["it", 96.172, 96.308], ["would", 96.583, 96.719], ["you", 96.719, 96.828], ["let", 96.828, 96.983], ["him", 96.983, 97.101], ["carry", 97.101, 97.382], ["them", 97.382, 97.627], ["a", 97.913, 98.294], ["yes", 98.495, 98.967], ["b", 99.207, 99.634], ["never", 99.845, 100.345], ["comment", 100.553, 101.035], ["a", 101.035, 101.298], ["or", 101.298, 101.48], ["b", 101.48, 102.006]], "lines": [[0.0, 4.596, "In this town, the dungeon under the castle picks one master every thousand years."], [4.818, 7.206, "This year, it picked the torch boy. Me."], [7.339, 13.908, "The dungeon has nine floors of monsters. The prince went down every summer with fifty knights, and his record was floor three."], [14.136, 15.817, "I was the kid who carried their torches."], [16.075, 22.339, "And every night, I left one torch burning at the dungeon gate, because I didn't like the idea of anything sitting alone in the dark."], [22.647, 29.051, "This summer, he took us down to floor four, and the walls started to shake. The knights ran, and the prince left me behind."], [29.25, 31.412, "\"Keep the monsters busy, torch boy.\""], [31.732, 32.822, "Then my torch went out."], [33.103, 41.296, "A second later, every torch on all nine floors lit up at once, and a deep voice came out of the walls. It said, \"Master.\""], [42.005, 44.618, "I didn't know what else to say, so I tried, \"Stairs.\""], [44.905, 47.575, "The wall in front of me folded open like a paper fan."], [47.794, 49.144, "Then I tried, \"Ride.\""], [49.411, 54.978, "A dragon the size of the church walked out of the dark and lay down at my feet, like a dog waiting for a walk."], [55.273, 58.234, "I found the prince on floor three, surrounded by goblins."], [58.45, 61.329, "The goblins took one look at me and stepped aside like a curtain."], [61.604, 63.53, "The prince whispered, \"What are you?\""], [63.76, 69.979, "I said, \"You brought fifty knights and made it to floor three. I brought one torch, and now I own all nine.\""], [70.251, 73.647, "Then I rode the dragon up the stairs and into the middle of the town square."], [73.88, 75.424, "The whole square went silent."], [75.669, 80.028, "The prince came out behind me, carried by three goblins, because his legs had stopped working."], [80.274, 87.259, "Everyone asked why the dungeon would choose a torch boy. But I knew. For six years, I was the only one who left a light on for it."], [87.483, 90.108, "Even a dungeon remembers who was kind to it in the dark."], [90.388, 94.829, "The next morning, the prince knocked on my door and asked if I needed someone to carry my torches."], [95.1, 96.308, "I told him I'd think about it."], [96.583, 100.345, "Would you let him carry them? A, yes. B, never."], [100.553, 102.006, "Comment A or B."]]}