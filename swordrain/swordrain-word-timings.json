, 65.303], ["i", 65.594, 65.699], ["said", 65.699, 66.024], ["both", 66.024, 66.412], ["of", 66.412, 66.56], ["us", 66.56, 66.907], ["it", 67.207, 67.307], ["landed", 67.307, 67.648], ["on", 67.648, 67.748], ["my", 67.748, 67.882], ["left", 67.882, 68.265], ["the", 68.448, 68.523], ["wind", 68.523, 68.907], ["knocked", 68.907, 69.173], ["us", 69.173, 69.315], ["flat", 69.315, 69.723], ["when", 70.057, 70.165], ["the", 70.165, 70.24], ["dust", 70.24, 70.565], ["cleared", 70.565, 70.965], ["a", 71.182, 71.248], ["wall", 71.248, 71.665], ["of", 71.665, 71.732], ["steel", 71.732, 72.24], ["stood", 72.24, 72.498], ["between", 72.498, 72.84], ["two", 72.84, 73.057], ["kingdoms", 73.057, 73.582], ["taller", 73.723, 74.115], ["than", 74.115, 74.273], ["both", 74.273, 74.523], ["castles", 74.523, 75.073], ["the", 75.448, 75.54], ["king", 75.54, 75.848], ["wanted", 75.848, 76.115], ["it", 76.115, 76.282], ["he", 76.498, 76.598], ["sent", 76.598, 76.832], ["ten", 76.832, 77.09], ["thousand", 77.09, 77.473], ["men", 77.473, 77.673], ["to", 77.673, 77.748], ["drag", 77.748, 78.032], ["it", 78.032, 78.098], ["out", 78.098, 78.365], ["it", 78.582, 78.673], ["didn't", 78.673, 78.873], ["move", 78.873, 79.065], ["an", 79.065, 79.148], ["inch", 79.148, 79.582], ["i", 79.915, 79.99], ["put", 79.99, 80.157], ["one", 80.157, 80.39], ["hand", 80.39, 80.665], ["on", 80.665, 80.807], ["it", 80.807, 80.94], ["and", 81.157, 81.273], ["i", 81.273, 81.365], ["lifted", 81.365, 81.84], ["then", 82.207, 82.323], ["a", 82.323, 82.365], ["new", 82.365, 82.573], ["shadow", 82.573, 82.915], ["fell", 82.915, 83.132], ["over", 83.132, 83.29], ["both", 83.29, 83.557], ["kingdoms", 83.557, 83.998], ["a", 84.332, 84.373], ["sword", 84.373, 84.74], ["that", 84.74, 84.932], ["big", 84.932, 85.148], ["fell", 85.148, 85.398], ["from", 85.398, 85.565], ["a", 85.565, 85.607], ["hand", 85.607, 86.015], ["that", 86.015, 86.198], ["big", 86.198, 86.49], ["nobody", 86.832, 87.14], ["here", 87.14, 87.365], ["ever", 87.365, 87.607], ["asked", 87.607, 87.94], ["who", 87.94, 88.048], ["drops", 88.048, 88.39], ["them", 88.39, 88.573], ["this", 88.923, 89.115], ["one", 89.115, 89.323], ["had", 89.323, 89.523], ["fingers", 89.523, 90.157], ["do", 90.523, 90.623], ["i", 90.623, 90.698], ["keep", 90.698, 90.94], ["it", 90.94, 91.073], ["or", 91.273, 91.34], ["give", 91.34, 91.49], ["it", 91.49, 91.582], ["back", 91.582, 91.907], ["a", 92.257, 92.573], ["keep", 92.782, 92.998], ["it", 92.998, 93.157], ["b", 93.423, 93.807], ["give", 93.99, 94.115], ["it", 94.115, 94.207], ["back", 94.207, 94.64]], "lines": [[0.0, 4.05, "In this town, it rains swords once a year. You keep the one that lands next to you."], [4.333, 8.35, "A sword only moves for its owner. The blacksmith can't lift his own kid's dagger."], [8.75, 10.458, "I'm Fold. Mine never landed."], [10.758, 13.4, "It's been falling for four years. Every year, it's bigger."], [13.817, 17.375, "Tomorrow at noon, it finally gets here. And it's bigger than the castle."], [17.825, 20.45, "A sword never hits its owner. It lands right next to him."], [20.842, 23.542, "So wherever I'm standing tomorrow gets a castle dropped on it."], [23.958, 26.808, "My whole street moved away from me. Everyone but my sister."], [27.225, 30.273, "Nell said, \"If it lands, it lands on both of us.\""], [30.64, 31.898, "The king had a better idea."], [32.24, 34.973, "He rode me to the next kingdom, and stood me at their front gate."], [35.207, 38.261, "He said, \"You're not a boy. You're how I aim.\""], [38.653, 41.078, "There were kids on their wall. One of them waved at me."], [41.486, 44.428, "At noon, the sky went dark. I could hear it whistling."], [44.769, 46.652, "And the guards let go of me. All of them."], [46.986, 50.336, "For one minute, I was the most dangerous thing in two kingdoms."], [50.678, 51.803, "So I walked toward the king."], [52.086, 53.678, "His whole army got out of my way."], [53.986, 55.686, "I started running. He ran faster."], [55.961, 57.878, "But I wasn't dropping a castle on anybody."], [58.161, 61.278, "I stopped in the empty field, halfway between his army and their wall."], [61.586, 63.044, "Then somebody grabbed my right hand."], [63.352, 66.907, "Nell. She'd hidden in the supply wagon. \"I said both of us.\""], [67.207, 69.723, "It landed on my left. The wind knocked us flat."], [70.057, 75.073, "When the dust cleared, a wall of steel stood between two kingdoms, taller than both castles."], [75.448, 78.365, "The king wanted it. He sent ten thousand men to drag it out."], [78.582, 79.582, "It didn't move an inch."], [79.915, 81.84, "I put one hand on it, and I lifted."], [82.207, 83.998, "Then a new shadow fell over both kingdoms."], [84.332, 86.49, "A sword that big fell from a hand that big."], [86.832, 88.573, "Nobody here ever asked who drops them."], [88.923, 90.157, "This one had fingers."], [90.523, 94.64, "Do I keep it, or give it back? A, keep it. B, give it back."]]}