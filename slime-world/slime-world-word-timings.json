w", 113.075, 113.292], ["tiny", 113.292, 113.708], ["is", 113.708, 113.83], ["the", 113.83, 113.916], ["size", 113.916, 114.255], ["of", 114.255, 114.315], ["an", 114.315, 114.411], ["apple", 114.411, 114.732], ["again", 114.732, 115.096], ["almost", 115.293, 115.883], ["tonight", 116.038, 116.671], ["he", 116.671, 116.775], ["tried", 116.775, 117.009], ["to", 117.009, 117.07], ["climb", 117.07, 117.365], ["back", 117.365, 117.59], ["into", 117.59, 117.79], ["his", 117.79, 117.868], ["shell", 117.868, 118.293], ["he", 118.57, 118.639], ["doesn't", 118.639, 118.925], ["fit", 118.925, 119.324], ["somebody", 119.546, 120.032], ["didn't", 120.032, 120.362], ["mean", 120.362, 120.552], ["it", 120.552, 120.813], ["who", 121.07, 121.191], ["do", 121.191, 121.244], ["you", 121.244, 121.33], ["think", 121.33, 121.495], ["it", 121.495, 121.547], ["was", 121.547, 122.067]], "lines": [[0.052, 4.449, "In this town, every kid gets an egg, and whatever hatches is yours for life."], [4.747, 7.34, "Its level floats over its head the second the shell cracks."], [7.601, 11.056, "Tobin's egg was the size of a barrel. A wolf. Level forty."], [11.263, 15.293, "The king's egg took four men to carry. A dragon. Level ninety-nine."], [15.579, 17.002, "My egg fit in one hand."], [17.133, 20.547, "It cracked. A slime. The size of an apple. Level one."], [20.815, 22.073, "The whole square laughed."], [22.3, 23.254, "I named him Tiny."], [23.473, 24.253, "Tobin kicked him."], [24.431, 25.038, "He doubled."], [25.233, 27.835, "Now he was the size of a dog. Still level one."], [28.063, 29.895, "Tobin kicked him again. A cow."], [30.181, 31.776, "Tobin is not a fast learner."], [31.981, 35.417, "He stopped laughing on the third kick, because Tiny was looking down at him."], [35.64, 39.598, "The guards came with spears. Every spear that touched him made him twice as big."], [39.824, 41.489, "The guards are not fast learners either."], [41.739, 43.577, "Hit nine. Taller than the houses."], [43.778, 47.62, "Hit twelve. He rolled over the whole street, and we were all inside him."], [47.862, 52.066, "You can breathe in there. Everything is green and slow, like the bottom of a lake."], [52.323, 54.714, "A horse floated past me. It seemed fine with it."], [54.958, 58.326, "Then the king, still on his throne, acting like this was the plan."], [58.565, 60.508, "Everyone inside started punching to get out."], [60.678, 62.118, "And every punch was a hit."], [62.286, 64.402, "Hit fifteen. Tiny swallowed the castle."], [64.577, 66.165, "Hit nineteen. The mountains."], [66.407, 69.911, "Hit twenty-three. His shadow fell on kingdoms that had never heard of us."], [70.132, 73.491, "I did the math. At hit twenty-seven, Tiny is bigger than the world."], [73.702, 74.786, "We were at twenty-six."], [75.037, 76.859, "The king drew his sword to cut his way out."], [77.044, 78.016, "I swam in front of him."], [78.259, 79.152, "Stop hitting him."], [79.386, 80.418, "It's a monster, boy."], [80.65, 83.414, "He's level one. He's a baby. And he's scared of you."], [83.628, 87.975, "Way down in the middle, I could still see him. The real one. Apple-sized. Shaking."], [88.209, 89.501, "I swam down and held him."], [89.727, 93.63, "He only gets smaller one way. Somebody has to say sorry, and mean it."], [93.857, 97.899, "So the whole kingdom lined up, inside a slime, to apologize to my pet."], [98.087, 101.935, "The baker. The guards. Tobin, twice. The first one didn't count."], [102.18, 103.733, "Every sorry cut him in half."], [103.936, 106.814, "The king went last. He said, Mistakes were made."], [107.034, 107.771, "Nothing happened."], [107.971, 109.764, "He tried again. On his knees."], [109.977, 112.875, "The mountains came back. Then the castle. Then our street."], [113.075, 115.883, "Now Tiny is the size of an apple again. Almost."], [116.038, 118.293, "Tonight he tried to climb back into his shell."], [118.57, 119.324, "He doesn't fit."], [119.546, 120.813, "Somebody didn't mean it."], [121.07, 122.067, "Who do you think it was?"]]}