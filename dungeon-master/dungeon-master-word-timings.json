is", 39.077, 39.179], ["bedroom", 39.179, 39.526], ["now", 39.526, 39.81], ["he", 39.986, 40.088], ["offered", 40.088, 40.341], ["me", 40.341, 40.42], ["gold", 40.42, 40.861], ["i", 41.027, 41.122], ["said", 41.122, 41.327], ["no", 41.327, 41.674], ["he", 41.838, 41.925], ["offered", 41.925, 42.162], ["me", 42.162, 42.241], ["the", 42.241, 42.304], ["crown", 42.304, 42.785], ["i", 42.943, 43.038], ["said", 43.038, 43.267], ["no", 43.267, 43.606], ["i", 43.769, 43.88], ["asked", 43.88, 44.179], ["for", 44.179, 44.29], ["one", 44.29, 44.613], ["thing", 44.613, 44.976], ["the", 45.135, 45.206], ["prince", 45.206, 45.624], ["sweeps", 45.624, 45.979], ["the", 45.979, 46.042], ["steps", 46.042, 46.468], ["he's", 46.613, 46.825], ["terrible", 46.825, 47.291], ["at", 47.291, 47.441], ["it", 47.441, 47.567], ["a", 47.768, 47.831], ["paladin", 47.831, 48.273], ["gets", 48.273, 48.423], ["a", 48.423, 48.462], ["castle", 48.462, 48.904], ["i", 49.076, 49.179], ["got", 49.179, 49.329], ["everything", 49.329, 49.699], ["under", 49.699, 49.92], ["it", 49.92, 50.046], ["and", 50.233, 50.383], ["tonight", 50.383, 50.746], ["i'm", 50.919, 51.061], ["moving", 51.061, 51.471], ["the", 51.471, 51.534], ["castle", 51.534, 51.937], ["i", 52.114, 52.209], ["haven't", 52.209, 52.39], ["told", 52.39, 52.603], ["it", 52.603, 52.658], ["where", 52.658, 53.037]], "lines": [[0.063, 7.511, "In this town, a stone gives every kid a class. Most get Farmer. The prince got Paladin. Mine said Dungeon Master, and then the stone cracked in half."], [7.754, 10.752, "The king laughed, and handed me a broom. Dungeon steps."], [11.134, 15.97, "That night, the prince marched his party in to prove I was nothing. He took my little brother to carry the torches."], [16.201, 21.252, "Everyone thought I'd run in after them. I didn't. I asked the dungeon to send my brother up. He arrived in a bucket."], [21.436, 26.032, "Then I rearranged things. Floor nine is now floor one. The exit is now a pond."], [26.237, 29.793, "The prince drew his sword on the dragon. I'd already swapped the dragon for a goose."], [29.994, 32.316, "He laughed. So I put the dragon back. Behind him."], [32.495, 35.59, "He ran for the stairs. I made the stairs a slide. Going down."], [35.785, 39.81, "The king sent his army to arrest me. So I moved the dungeon door. It's in his bedroom now."], [39.986, 43.606, "He offered me gold. I said no. He offered me the crown. I said no."], [43.769, 46.468, "I asked for one thing. The prince sweeps the steps."], [46.613, 47.567, "He's terrible at it."], [47.768, 50.046, "A Paladin gets a castle. I got everything under it."], [50.233, 53.037, "And tonight, I'm moving the castle. I haven't told it where."]]}