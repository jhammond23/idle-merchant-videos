88.037, 88.445], ["lit", 88.445, 88.653], ["up", 88.653, 88.795], ["over", 88.795, 89.02], ["its", 89.02, 89.145], ["head", 89.145, 89.437], ["it", 89.745, 89.845], ["said", 89.845, 90.17], ["one", 90.412, 90.837], ["so", 91.278, 91.437], ["who's", 91.437, 91.603], ["stronger", 91.603, 92.12], ["a", 92.32, 92.645], ["me", 92.737, 93.128], ["or", 93.312, 93.42], ["b", 93.42, 93.845], ["the", 93.987, 94.062], ["thing", 94.062, 94.253], ["under", 94.253, 94.387], ["the", 94.387, 94.47], ["castle", 94.47, 94.92], ["follow", 95.195, 95.578], ["if", 95.578, 95.662], ["you'd", 95.662, 95.828], ["bet", 95.828, 95.978], ["on", 95.978, 96.07], ["the", 96.07, 96.128], ["level", 96.128, 96.395], ["one", 96.395, 96.745]], "lines": [[0.0, 2.808, "In this town, the number over your head is how strong you are."], [3.175, 4.258, "Most people are level ten."], [4.55, 7.183, "The king's dragon is ninety-nine, the highest ever."], [7.642, 8.417, "I'm level one."], [8.917, 11.558, "Every year, the king puts the weakest kid in front of his dragon."], [11.908, 14.433, "He calls it a tradition. The dragon calls it lunch."], [14.817, 16.408, "This year, that kid was me."], [16.825, 18.4, "Then my little sister jumped in front of me."], [18.75, 21.517, "The dragon swung its claw at her, and I caught it with one hand."], [21.883, 23.3, "The whole square went silent."], [23.7, 26.483, "The dragon pushed down hard, but my feet didn't even slide."], [26.808, 29.15, "So I grabbed its claw, and I threw it over the castle."], [29.475, 32.425, "We heard it land behind the mountain, like a barn falling off a cliff."], [32.833, 36.725, "I looked up at the king and said, \"Sorry, Your Majesty. I guess we're not on the same level.\""], [37.167, 40.717, "Then my sister held up my hand, the one with a hundred written on it in charcoal."], [41.083, 44.367, "She writes it there every morning, because she says the stone got me wrong."], [44.792, 47.15, "Every day, the whole town laughed at her for it."], [47.558, 48.833, "Nobody was laughing now."], [49.192, 51.883, "The king was so angry that he sent fifty knights to grab her."], [52.208, 53.475, "I stamped my foot once."], [53.725, 55.442, "The ground jumped like a dropped plate."], [55.717, 57.908, "All fifty knights fell over like toy soldiers."], [58.167, 60.499, "The king screamed, \"He's level ONE!\""], [60.949, 64.024, "Then the old man who reads everyone's number on his stone started to laugh."], [64.282, 71.21, "He said, \"Your Majesty, my stone only counts to ninety-nine. After that, it starts over at one.\""], [71.71, 73.952, "The whole town turned and looked at my hand."], [74.452, 76.152, "My sister had been right the whole time."], [76.527, 79.118, "I was never level one. I was level one hundred."], [79.477, 81.027, "She just counted better than the stone."], [81.393, 84.253, "She squeezed my hand and whispered, \"I told them.\""], [84.678, 87.57, "Then, deep under the castle, something opened its eyes."], [87.97, 89.437, "A number lit up over its head."], [89.745, 90.837, "It said one."], [91.278, 94.92, "So who's stronger? A, me. Or B, the thing under the castle?"], [95.195, 96.745, "Follow if you'd bet on the level one."]]}