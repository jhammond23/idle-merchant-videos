37, 63.339], ["punches", 63.339, 63.66], ["a", 63.66, 63.699], ["mountain", 63.699, 64.021], ["of", 64.021, 64.123], ["rock", 64.123, 64.405], ["every", 64.405, 64.594], ["night", 64.594, 64.884], ["my", 65.103, 65.228], ["fake", 65.228, 65.495], ["power", 65.495, 65.793], ["never", 65.793, 66.02], ["made", 66.02, 66.216], ["me", 66.216, 66.303], ["strong", 66.303, 66.789], ["the", 66.945, 67.008], ["boulders", 67.008, 67.471], ["did", 67.471, 67.737], ["the", 67.92, 67.998], ["duke", 67.998, 68.226], ["laughed", 68.226, 68.508], ["so", 68.508, 68.751], ["hard", 68.751, 68.987], ["at", 68.987, 69.057], ["weak", 69.057, 69.3], ["kids", 69.3, 69.598], ["that", 69.598, 69.7], ["he", 69.7, 69.787], ["made", 69.787, 69.943], ["a", 69.943, 69.983], ["strong", 69.983, 70.39], ["one", 70.39, 70.61], ["and", 70.821, 70.892], ["he", 70.892, 70.955], ["called", 70.955, 71.19], ["half", 71.19, 71.41], ["this", 71.41, 71.59], ["town's", 71.59, 71.904], ["kids", 71.904, 72.194], ["fake", 72.194, 72.578], ["the", 72.817, 72.88], ["crowd", 72.88, 73.185], ["looked", 73.185, 73.366], ["down", 73.366, 73.64], ["at", 73.64, 73.719], ["their", 73.719, 73.883], ["own", 73.883, 74.033], ["fists", 74.033, 74.527], ["then", 74.713, 74.83], ["a", 74.83, 74.87], ["badge", 74.87, 75.27], ["hit", 75.27, 75.387], ["the", 75.387, 75.45], ["ground", 75.45, 75.756], ["behind", 75.756, 76.077], ["me", 76.077, 76.25], ["the", 76.44, 76.502], ["captain", 76.502, 76.84], ["was", 76.84, 76.981], ["throwing", 76.981, 77.263], ["his", 77.263, 77.436], ["away", 77.436, 77.828], ["twenty", 78.002, 78.34], ["years", 78.34, 78.795], ["top", 78.935, 79.225], ["rank", 79.225, 79.555], ["almost", 79.728, 80.026], ["twice", 80.026, 80.348], ["as", 80.348, 80.426], ["long", 80.426, 80.661], ["as", 80.661, 80.748], ["i've", 80.748, 80.889], ["been", 80.889, 81.006], ["alive", 81.006, 81.469], ["he", 81.706, 81.76], ["wasn't", 81.76, 81.988], ["looking", 81.988, 82.239], ["at", 82.239, 82.302], ["me", 82.302, 82.545], ["he", 82.728, 82.783], ["was", 82.783, 82.9], ["looking", 82.9, 83.136], ["at", 83.136, 83.191], ["my", 83.191, 83.308], ["sister", 83.308, 83.74], ["and", 83.908, 83.987], ["i", 83.987, 84.041], ["was", 84.041, 84.159], ["still", 84.159, 84.441], ["holding", 84.441, 84.739], ["her", 84.739, 84.951], ["what", 85.17, 85.272], ["would", 85.272, 85.366], ["they", 85.366, 85.468], ["call", 85.468, 85.727], ["your", 85.727, 86.017], ["power", 86.017, 86.582]], "lines": [[0.0, 4.078, "In this town, every kid gets a fighting power at twelve, and the duke ranks us all."], [4.271, 7.769, "The baker's kid got hot hands and brags. The captain got thunder fists."], [7.98, 10.607, "Mine's a fake. My fists just glow like lanterns."], [10.891, 12.577, "Every night, I punched boulders anyway."], [12.783, 15.559, "Today a stone giant stomped onto my little sister's bridge."], [15.747, 17.708, "She's five. She hums everywhere."], [17.93, 19.797, "So I ran past the guards. All of them."], [20.001, 22.417, "My fists lit up. The whole crowd gasped."], [22.632, 24.668, "\"Go home, lantern boy,\" the captain said."], [24.87, 25.435, "\"Make me.\""], [25.632, 29.029, "He has the strongest power alive. He shoved me with thunder fists."], [29.201, 31.145, "His boots slid backward. I didn't move."], [31.354, 33.957, "The giant swung a boulder. I caught it with one fist."], [34.125, 35.958, "Yes. It felt as good as you think."], [36.151, 38.073, "One jump, and I was on the giant's arm."], [38.247, 41.102, "I hit his rocky arm. It cracked, and he fell in the river."], [41.33, 44.145, "A beam had fallen on my sister. I lifted it like a twig."], [44.37, 46.574, "Then I did the one thing I was never allowed to do."], [46.763, 47.641, "I hugged her tight."], [47.868, 51.087, "The duke always said glowing fists burn things. I believed him."], [51.278, 52.78, "She didn't burn. She laughed."], [53.009, 53.825, "I looked up at the duke."], [53.997, 56.16, "He never got a power at all. So what does that make him?"], [56.506, 58.703, "\"Arrest him!\" he squeaked. Nobody moved."], [58.922, 59.91, "Here's what the duke missed."], [60.077, 62.273, "More boulders every night. Never enough."], [62.452, 64.884, "What happens to a kid who punches a mountain of rock every night?"], [65.103, 66.789, "My fake power never made me strong."], [66.945, 67.737, "The boulders did."], [67.92, 70.61, "The duke laughed so hard at weak kids that he made a strong one."], [70.821, 72.578, "And he called half this town's kids fake."], [72.817, 74.527, "The crowd looked down at their own fists."], [74.713, 76.25, "Then a badge hit the ground behind me."], [76.44, 77.828, "The captain was throwing his away."], [78.002, 79.555, "Twenty years. Top rank."], [79.728, 81.469, "Almost twice as long as I've been alive."], [81.706, 83.74, "He wasn't looking at me. He was looking at my sister."], [83.908, 84.951, "And I was still holding her."], [85.17, 86.582, "What would they call your power?"]]}