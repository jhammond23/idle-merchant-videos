], ["then", 82.484, 82.627], ["a", 82.627, 82.675], ["badge", 82.675, 83.065], ["hit", 83.065, 83.184], ["the", 83.184, 83.248], ["ground", 83.248, 83.535], ["behind", 83.535, 83.853], ["me", 83.853, 84.004], ["the", 84.211, 84.275], ["captain", 84.275, 84.633], ["had", 84.633, 84.745], ["thrown", 84.745, 84.992], ["his", 84.992, 85.119], ["away", 85.119, 85.509], ["twenty", 85.705, 86.055], ["years", 86.055, 86.413], ["at", 86.413, 86.509], ["top", 86.509, 86.787], ["rank", 86.787, 87.106], ["he", 87.331, 87.387], ["wasn't", 87.387, 87.626], ["looking", 87.626, 87.865], ["at", 87.865, 87.937], ["the", 87.937, 88.0], ["duke", 88.0, 88.319], ["he", 88.48, 88.551], ["was", 88.551, 88.671], ["looking", 88.671, 88.91], ["at", 88.91, 88.973], ["my", 88.973, 89.085], ["sister", 89.085, 89.523], ["and", 89.718, 89.806], ["i", 89.806, 89.869], ["was", 89.869, 89.981], ["still", 89.981, 90.283], ["holding", 90.283, 90.602], ["her", 90.602, 90.801], ["what", 91.108, 91.212], ["would", 91.212, 91.299], ["they", 91.299, 91.403], ["call", 91.403, 91.61], ["your", 91.61, 91.817], ["power", 91.817, 92.215]], "lines": [[0.0, 4.029, "In this town, every kid gets a fighting power at twelve, and the duke ranks us all."], [4.265, 8.214, "The baker's kid got hot hands. The duke's captain got thunder fists, top rank."], [8.457, 12.728, "My fists just glow like lanterns. The duke gave me a zero badge and called them fake."], [12.934, 16.175, "He says glowing fists burn people, so zeros can't touch anyone."], [16.356, 19.419, "Not even my little sister. She's five. She hums everywhere."], [19.768, 22.902, "Zeros also haul the duke's boulders. We pile them under the bridge."], [23.139, 25.185, "Every night, I punched those boulders anyway."], [25.498, 27.64, "Today the whole town came to the bridge for the ranking."], [27.847, 29.408, "My sister sat on the rail, humming."], [29.62, 32.891, "Then the boulder pile under the bridge stood up. It was a stone giant."], [33.075, 36.363, "Its first stomp knocked a beam loose, and the beam trapped my sister."], [36.555, 37.423, "So I ran for her."], [37.668, 40.666, "The captain stepped in front of me. \"Zeros can't touch her, lantern boy.\""], [40.962, 41.384, "\"Watch me.\""], [41.625, 43.265, "So he shoved me with his thunder fists."], [43.475, 45.376, "His boots slid backward. I didn't move."], [45.59, 47.166, "The baker's kid hid his hot hands."], [47.408, 51.196, "Then the giant swung a boulder at the bridge. I caught it with one glowing fist."], [51.386, 53.289, "One jump, and I was on the giant's arm."], [53.498, 55.56, "I punched it the way I punch boulders every night."], [55.777, 58.166, "The arm cracked, and the giant crashed into the river."], [58.382, 60.874, "I ran back and lifted the beam off my sister like a twig."], [61.087, 63.65, "Then I did the one thing zeros are never allowed to do."], [63.864, 64.748, "I hugged her tight."], [64.943, 66.509, "She didn't burn. She laughed."], [66.749, 67.871, "Everyone turned to the duke."], [68.144, 70.474, "\"Arrest him!\" he squeaked. Nobody moved."], [70.739, 71.782, "Here's what the duke missed."], [71.996, 74.48, "Every night, he made us zeros haul more boulders."], [74.655, 76.2, "And every night, I punched them."], [76.426, 78.393, "My glowing fists never made me strong."], [78.574, 79.465, "His boulders did."], [79.674, 82.222, "He laughed so hard at weak kids that he made a strong one."], [82.484, 84.004, "Then a badge hit the ground behind me."], [84.211, 87.106, "The captain had thrown his away. Twenty years at top rank."], [87.331, 89.523, "He wasn't looking at the duke. He was looking at my sister."], [89.718, 90.801, "And I was still holding her."], [91.108, 92.215, "What would they call your power?"]]}