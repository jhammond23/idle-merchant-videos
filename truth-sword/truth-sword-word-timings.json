st", 83.687, 83.863], ["told", 83.863, 84.033], ["the", 84.033, 84.094], ["truth", 84.094, 84.463], ["his", 84.665, 84.788], ["scabbard", 84.788, 85.181], ["is", 85.181, 85.288], ["empty", 85.288, 85.696], ["the", 85.852, 85.913], ["captain", 85.913, 86.252], ["looked", 86.252, 86.552], ["it's", 86.754, 86.9], ["true", 86.9, 87.284], ["his", 87.465, 87.588], ["sword", 87.588, 87.927], ["grew", 87.927, 88.142], ["a", 88.142, 88.165], ["foot", 88.165, 88.534], ["then", 88.714, 88.868], ["every", 88.868, 89.199], ["guard", 89.199, 89.529], ["told", 89.529, 89.729], ["the", 89.729, 89.791], ["truth", 89.791, 90.114], ["and", 90.268, 90.453], ["every", 90.453, 90.768], ["sword", 90.768, 91.153], ["grew", 91.153, 91.545], ["except", 91.725, 92.002], ["the", 92.002, 92.064], ["king's", 92.064, 92.494], ["he", 92.676, 92.83], ["hid", 92.83, 93.014], ["his", 93.014, 93.168], ["lie", 93.168, 93.445], ["for", 93.445, 93.576], ["ten", 93.576, 93.86], ["years", 93.86, 94.307], ["my", 94.501, 94.631], ["sword", 94.631, 94.924], ["found", 94.924, 95.185], ["it", 95.185, 95.27], ["in", 95.27, 95.362], ["one", 95.362, 95.601], ["sentence", 95.601, 96.093], ["do", 96.343, 96.451], ["i", 96.451, 96.527], ["take", 96.527, 96.727], ["the", 96.727, 96.804], ["crown", 96.804, 97.227], ["a", 97.472, 97.796], ["yes", 97.923, 98.338], ["b", 98.511, 98.858], ["no", 99.013, 99.336], ["i'm", 99.482, 99.612], ["a", 99.612, 99.643], ["stable", 99.643, 99.989], ["boy", 99.989, 100.42]], "lines": [[0.0, 2.931, "In this town, your sword grows every time you tell the truth."], [3.121, 5.998, "I'm the stable boy, and my sword is longer than the castle bridge."], [6.205, 8.49, "Every Sword Day, I stand at the back with my shovel."], [8.725, 12.249, "The Prince pulled the Golden Sword. It shone so bright the crowd squinted."], [12.446, 15.755, "He pointed it at me. \"Careful, stable boy. Don't trip over your spoon.\""], [16.0, 18.161, "The whole courtyard laughed, even the King."], [18.371, 21.109, "That morning, my sword was a spoon. Rusty, too."], [21.338, 23.615, "Then the Sword Master rang the bell for the Truth Test."], [23.787, 26.88, "Every kid stands on the stone and says one true thing out loud."], [27.057, 29.534, "Lie on it, and your sword shrinks in front of everyone."], [29.759, 31.874, "Nobody has passed it clean in a hundred years."], [32.079, 35.371, "The old story says the longest sword belongs to whoever should wear the crown."], [35.594, 39.41, "The stone was cold as a frozen pond, and every lie cracked like a plate."], [39.64, 42.276, "The Prince went first. \"I have never cheated at anything.\""], [42.489, 42.881, "Crack."], [43.09, 45.638, "His sword shrank. And shrank. Into a toothpick."], [45.843, 46.912, "Nobody laughed this time."], [47.129, 47.906, "Then it was my turn."], [48.111, 49.934, "I stepped on, and my knees were shaking."], [50.138, 52.432, "So I said the truest thing I had. \"I'm scared.\""], [52.65, 55.396, "My spoon grew. Past my knees. Past my head."], [55.601, 58.065, "Then I said, \"I have never told a lie in my life.\""], [58.316, 61.462, "My sword shot over the rooftops, over the bridge, through a cloud."], [61.639, 63.973, "The Sword Master whispered, \"That's a king's sword.\""], [64.191, 66.266, "The whole town gasped. The King didn't."], [66.458, 67.489, "He wasn't surprised at all."], [67.694, 69.339, "\"I knew this day would come,\" he said."], [69.564, 71.787, "Because ten years ago, the King stood on it too."], [71.927, 74.413, "He said one sentence. \"I will be a good king.\""], [74.641, 75.833, "His sword shrank to nothing."], [76.027, 77.688, "He's worn an empty scabbard ever since."], [77.872, 79.842, "\"Guards!\" he shouted. \"Take that sword!\""], [80.042, 82.58, "A hundred guards drew, and the gates slammed shut."], [82.777, 85.696, "I didn't swing. I just told the truth. \"His scabbard is empty.\""], [85.852, 88.534, "The captain looked. \"It's true.\" His sword grew a foot."], [88.714, 92.494, "Then every guard told the truth, and every sword grew. Except the King's."], [92.676, 96.093, "He hid his lie for ten years. My sword found it in one sentence."], [96.343, 100.42, "Do I take the crown? A, yes. B, no, I'm a stable boy."]]}