3.355], ["ten", 113.355, 113.712], ["years", 113.712, 114.126], ["hiding", 114.126, 114.483], ["me", 114.483, 114.642], ["in", 114.642, 114.736], ["the", 114.736, 114.877], ["ashes", 114.877, 115.347], ["he", 115.641, 115.744], ["forgot", 115.744, 116.167], ["where", 116.167, 116.355], ["a", 116.355, 116.383], ["phoenix", 116.383, 116.835], ["comes", 116.835, 117.154], ["from", 117.154, 117.436], ["what", 117.769, 117.873], ["would", 117.873, 118.014], ["you", 118.014, 118.145], ["name", 118.145, 118.38], ["your", 118.38, 118.483], ["phoenix", 118.483, 119.057]], "lines": [[0.085, 2.735, "In this town, the Phoenix bowed to me."], [3.035, 5.817, "Every royal kid gets a hunting bird on Hawking Day."], [6.073, 10.228, "I'm the ash boy who cleans their fireplaces, so I watch from the back with my bucket."], [10.464, 15.229, "This year, the Prince got the Golden Eagle. Nobody had seen one in ten years."], [15.475, 20.483, "Then he pointed at me and said, \"Keep sweeping, ash boy. Maybe one day a pigeon will pick you.\""], [21.298, 23.723, "The whole hall laughed, even the King."], [24.046, 26.198, "Then every candle in the hall went out."], [26.48, 32.739, "The cold fireplace behind the throne began to glow, and something stood up in the ashes with wings as wide as the hall."], [33.059, 36.809, "It was the Phoenix, and nobody had seen it in a thousand years."], [37.102, 41.341, "It flew the length of the hall, and every candle it passed lit itself again."], [41.65, 44.883, "It flew over the royal kids, and their birds hid their heads."], [45.152, 48.376, "The Prince held up his golden glove, like the Phoenix was coming for him."], [48.643, 50.326, "The Phoenix flew right past him."], [50.629, 53.838, "It flew all the way to the back of the hall, all the way to me."], [54.106, 55.75, "One step away, it landed."], [56.361, 59.833, "Then it folded its wings and bowed its head to the floor."], [60.123, 62.865, "The whole hall gasped, but the King didn't."], [63.11, 65.95, "He stood up and said, \"I knew it would come back for him.\""], [66.32, 70.033, "The old story says the Phoenix only rises for the next true king."], [70.362, 73.548, "Ten years ago, the King took the throne from my real father."], [73.812, 76.632, "Then he hid the baby prince where a phoenix would never look."], [76.928, 79.802, "It would look for a prince, not a boy covered in soot."], [80.06, 81.921, "Then the King shouted, \"Put it out!\""], [82.185, 86.584, "A hundred guards ran in with buckets of water, and the doors slammed shut behind us."], [86.9, 88.065, "The Phoenix didn't fight."], [88.373, 92.16, "It pulled one burning feather from its own wing and held it out to me."], [92.461, 95.956, "It should have burned me, but it felt as warm as my bucket of ashes."], [96.247, 100.25, "I lifted it over my head, and every bird in the hall left its royal kid."], [100.499, 105.264, "The falcons, the hawks, and even the Golden Eagle landed around me and bowed at once."], [105.57, 108.136, "A hundred buckets of water turned to steam."], [108.451, 112.267, "The Prince was the only one left holding up a glove, next to his father."], [112.603, 115.347, "The King spent ten years hiding me in the ashes."], [115.641, 117.436, "He forgot where a phoenix comes from."], [117.769, 119.057, "What would you name your phoenix?"]]}