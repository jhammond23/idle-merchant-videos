], ["window", 19.923, 20.24], ["to", 20.24, 20.441], ["see", 20.441, 20.588], ["if", 20.588, 20.665], ["mine", 20.665, 20.905], ["were", 20.905, 20.99], ["gone", 20.99, 21.337], ["they're", 21.566, 21.636], ["still", 21.636, 21.875], ["there", 21.875, 22.208], ["but", 22.371, 22.472], ["there's", 22.472, 22.619], ["a", 22.619, 22.657], ["second", 22.657, 23.005], ["set", 23.005, 23.214], ["now", 23.214, 23.415], ["bigger", 23.624, 23.995], ["bare", 24.088, 24.498], ["they", 24.668, 24.753], ["come", 24.753, 24.954], ["up", 24.954, 25.047], ["out", 25.047, 25.147], ["of", 25.147, 25.217], ["the", 25.217, 25.279], ["river", 25.279, 25.541], ["all", 25.719, 25.897], ["the", 25.897, 25.943], ["way", 25.943, 26.098], ["to", 26.098, 26.152], ["my", 26.152, 26.275], ["front", 26.275, 26.53], ["door", 26.53, 26.824], ["then", 27.009, 27.11], ["they", 27.11, 27.187], ["go", 27.187, 27.311], ["back", 27.311, 27.496], ["down", 27.496, 27.79], ["right", 27.952, 28.122], ["beside", 28.122, 28.47], ["mine", 28.47, 28.81], ["and", 29.01, 29.102], ["from", 29.102, 29.265], ["the", 29.265, 29.342], ["door", 29.342, 29.62], ["on", 29.62, 29.906], ["mine", 30.083, 30.346], ["aren't", 30.346, 30.547], ["footsteps", 30.547, 31.026], ["anymore", 31.026, 31.451], ["they're", 31.659, 31.79], ["two", 31.79, 32.138], ["long", 32.138, 32.532], ["lines", 32.532, 32.996], ["side", 33.158, 33.459], ["by", 33.459, 33.614], ["side", 33.614, 34.039], ["all", 34.223, 34.432], ["the", 34.432, 34.509], ["way", 34.509, 34.679], ["down", 34.679, 34.934], ["to", 34.934, 35.012], ["the", 35.012, 35.081], ["water", 35.081, 35.645]], "lines": [[0.0, 6.208, "In this town, your footprints show up the day before you make them. This morning, mine walk out my front door, down to the river, and stop."], [6.396, 11.078, "Everybody checks theirs at breakfast. The baker's go to the pub. Every single day. He acts surprised."], [11.269, 14.685, "Mine have never gone anywhere. School. Home. School. Until today."], [14.875, 18.291, "So tomorrow I'm not going anywhere. I've locked the door. I'm staying in bed."], [18.52, 21.337, "It's dark now. I just looked out the window, to see if mine were gone."], [21.566, 22.208, "They're still there."], [22.371, 24.498, "But there's a second set now. Bigger. Bare."], [24.668, 26.824, "They come up out of the river, all the way to my front door."], [27.009, 28.81, "Then they go back down, right beside mine."], [29.01, 31.451, "And from the door on, mine aren't footsteps anymore."], [31.659, 35.645, "They're two long lines, side by side, all the way down to the water."]]}