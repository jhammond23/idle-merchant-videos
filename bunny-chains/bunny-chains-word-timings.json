 61.56, 61.714], ["their", 61.714, 61.883], ["chains", 61.883, 62.244], ["too", 62.244, 62.537], ["and", 62.668, 62.783], ["they", 62.783, 62.86], ["walked", 62.86, 63.152], ["away", 63.152, 63.56], ["free", 63.667, 64.152], ["a", 64.358, 64.412], ["chain", 64.412, 64.781], ["can", 64.781, 64.889], ["make", 64.889, 65.019], ["a", 65.019, 65.05], ["monster", 65.05, 65.45], ["big", 65.45, 65.85], ["but", 65.85, 66.059], ["it", 66.059, 66.136], ["can't", 66.136, 66.39], ["make", 66.39, 66.552], ["it", 66.552, 66.629], ["yours", 66.629, 67.09], ["my", 67.324, 67.447], ["bunny", 67.447, 67.747], ["was", 67.747, 67.916], ["bigger", 67.916, 68.239], ["than", 68.239, 68.362], ["the", 68.362, 68.424], ["castle", 68.424, 68.87], ["ten", 69.087, 69.38], ["years", 69.38, 69.895], ["i", 70.064, 70.149], ["told", 70.149, 70.372], ["the", 70.372, 70.433], ["king", 70.433, 70.741], ["for", 70.913, 71.036], ["this", 71.036, 71.505], ["ten", 71.848, 72.148], ["years", 72.148, 72.633], ["that's", 72.818, 73.011], ["how", 73.011, 73.111], ["long", 73.111, 73.38], ["the", 73.38, 73.441], ["king", 73.441, 73.695], ["spent", 73.695, 73.964], ["making", 73.964, 74.249], ["chains", 74.249, 74.741], ["my", 74.965, 75.119], ["egg", 75.119, 75.349], ["was", 75.349, 75.48], ["never", 75.48, 75.711], ["late", 75.711, 75.996], ["it", 76.154, 76.23], ["was", 76.23, 76.346], ["waiting", 76.346, 76.569], ["for", 76.569, 76.677], ["dinner", 76.677, 77.038], ["the", 77.231, 77.285], ["floor", 77.285, 77.592], ["shook", 77.592, 77.969], ["and", 78.123, 78.208], ["the", 78.208, 78.261], ["king", 78.261, 78.577], ["went", 78.577, 78.746], ["pale", 78.746, 79.185], ["under", 79.393, 79.539], ["the", 79.539, 79.616], ["castle", 79.616, 80.031], ["the", 80.193, 80.262], ["kingdom's", 80.262, 80.724], ["oldest", 80.724, 81.147], ["egg", 81.147, 81.393], ["was", 81.393, 81.531], ["rattling", 81.531, 81.977], ["its", 81.977, 82.116], ["chains", 82.116, 82.608], ["my", 82.853, 82.96], ["bunny's", 82.96, 83.26], ["nose", 83.26, 83.591], ["twitched", 83.591, 83.991], ["it", 84.142, 84.25], ["looked", 84.25, 84.466], ["at", 84.466, 84.542], ["me", 84.542, 84.758], ["do", 84.962, 85.07], ["i", 85.07, 85.147], ["let", 85.147, 85.285], ["it", 85.285, 85.385], ["eat", 85.385, 85.555], ["them", 85.555, 85.77], ["a", 86.032, 86.332], ["yes", 86.49, 86.875], ["b", 87.071, 87.425], ["no", 87.583, 87.899], ["even", 88.053, 88.245], ["the", 88.245, 88.307], ["king's", 88.307, 88.66], ["scared", 88.66, 88.914], ["of", 88.914, 88.999], ["it", 88.999, 89.145], ["comment", 89.328, 89.712], ["a", 89.712, 89.966], ["or", 89.966, 90.135], ["b", 90.135, 90.566]], "lines": [[0.0, 3.798, "In this town, the longer an egg stays shut, the stronger the monster inside."], [4.046, 7.069, "My egg is ten years late, and tomorrow the king smashes it."], [7.321, 9.728, "Most eggs hatch in a day, into something cat-sized."], [9.939, 14.568, "For ten years, the king has chained his knights' eggs shut, so they hatch taller than his castle gate."], [14.802, 18.623, "He chains every late egg, but the chains on mine are always gone by morning."], [18.823, 20.0, "The king thinks I steal them."], [20.325, 26.532, "At noon, in the throne room, the guard captain's monster, a knight of black iron, raised its chained fist over my egg."], [26.759, 29.543, "My egg cracked, and out hopped a bunny the size of a teacup."], [29.767, 34.01, "The king laughed so hard his crown fell off. \"Ten years,\" he said, \"for that?\""], [34.364, 38.249, "I remembered the missing chains, so I grabbed the iron knight's chain and fed it to my bunny."], [38.451, 41.159, "Bunnies chew everything. Mine slurped it up like a noodle."], [41.326, 42.549, "It grew as big as a horse."], [42.774, 46.557, "Without its chain, the iron knight wasn't the king's anymore. It walked out the door."], [46.744, 50.459, "\"Chain that rabbit!\" the king screamed. \"Go ahead,\" I said. \"He's hungry.\""], [50.784, 55.46, "The knights threw chains on my bunny. It ate them like licorice and grew until its ears went through the roof."], [55.671, 60.901, "His two biggest monsters came for us: a black stag with crowns on its antlers, and a giant made of fog."], [61.121, 64.152, "My bunny ate their chains too, and they walked away, free."], [64.358, 67.09, "A chain can make a monster big, but it can't make it yours."], [67.324, 71.505, "My bunny was bigger than the castle. \"Ten years,\" I told the king, \"for this.\""], [71.848, 74.741, "Ten years. That's how long the king spent making chains."], [74.965, 77.038, "My egg was never late. It was waiting for dinner."], [77.231, 79.185, "The floor shook, and the king went pale."], [79.393, 82.608, "Under the castle, the kingdom's oldest egg was rattling its chains."], [82.853, 84.758, "My bunny's nose twitched. It looked at me."], [84.962, 89.145, "Do I let it eat them? A, yes. B, no, even the king's scared of it."], [89.328, 90.566, "Comment A or B."]]}