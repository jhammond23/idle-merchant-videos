["dad's", 88.644, 88.944], ["rat", 88.944, 89.336], ["he's", 89.669, 89.803], ["slept", 89.803, 90.094], ["on", 90.094, 90.169], ["my", 90.169, 90.311], ["pillow", 90.311, 90.619], ["since", 90.619, 90.819], ["i", 90.819, 90.877], ["was", 90.877, 91.044], ["born", 91.044, 91.478], ["he", 91.727, 91.819], ["had", 91.819, 91.928], ["never", 91.928, 92.228], ["seen", 92.228, 92.486], ["me", 92.486, 92.586], ["pull", 92.586, 93.011], ["what", 93.428, 93.528], ["do", 93.528, 93.578], ["you", 93.578, 93.661], ["think", 93.661, 93.903], ["i", 93.903, 94.019], ["am", 94.019, 94.411]], "lines": [[0.0, 2.833, "In this town, everyone is born with a string on their wrist."], [3.142, 5.525, "The other end is tied to the monster you're meant to fight."], [5.967, 8.6, "I'm Fold. Mine goes straight up, into the clouds."], [9.05, 13.275, "Most strings go to a rat in the cellar. The king's went to a dragon. That's why he's king."], [13.742, 16.025, "For ten years, mine has been pulling tighter."], [16.508, 20.533, "On your tenth birthday, you pull your monster in and fight it. Win, and it's yours."], [21.017, 21.717, "That's today."], [22.158, 24.633, "The whole town came to watch. From behind the wall."], [25.058, 27.433, "The king kept his dragon close. Just in case."], [27.867, 28.4, "I pulled."], [28.683, 30.633, "It pulled back. My feet left the ground."], [30.892, 33.792, "Dad grabbed my ankles. The captain grabbed his. Then the butcher."], [34.033, 36.758, "Forty people were holding on, and we were all still going up."], [37.058, 40.125, "We passed the church roof. The butcher said a word I'm not allowed to say."], [40.467, 42.492, "Then the clouds opened, and we saw it."], [42.858, 44.192, "It was bigger than the town."], [44.558, 47.9, "And it wasn't diving at us. It was climbing, as hard as it could."], [48.292, 51.394, "The captain yelled, \"That thing isn't attacking. It's running!\""], [51.711, 53.944, "From what? There was nothing up there but us."], [54.219, 58.236, "Forty people were hanging off my legs. If that string snapped, we all fell."], [58.519, 61.344, "I had never pulled as hard as I could. I never had a reason."], [61.619, 62.503, "So I pulled."], [62.844, 64.736, "It came down out of the clouds like a kite."], [65.019, 67.836, "It landed across the whole valley, and it would not look at me."], [68.136, 70.252, "The king's dragon tried to hide behind the king."], [70.627, 73.578, "Then every string in town went tight. All at once."], [73.869, 76.661, "The rats. The wolves. The bear. The dragon."], [76.928, 79.244, "Every monster in the kingdom was pulling away from me."], [79.586, 82.303, "Ten years, I thought mine was dragging me to a fight."], [82.586, 83.703, "It was trying to get away."], [84.094, 86.686, "To the biggest thing in the sky, I'm the monster."], [87.136, 91.478, "Even Biscuit pulled away. Dad's rat. He's slept on my pillow since I was born."], [91.727, 93.011, "He had never seen me pull."], [93.428, 94.411, "What do you think I am?"]]}