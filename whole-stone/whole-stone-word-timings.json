96], ["swords", 93.496, 94.19], ["he", 94.324, 94.433], ["said", 94.433, 94.724], ["i", 94.998, 95.19], ["was", 95.19, 95.398], ["the", 95.398, 95.473], ["smallest", 95.473, 96.056], ["do", 96.365, 96.465], ["we", 96.465, 96.557], ["wake", 96.557, 96.748], ["the", 96.748, 96.865], ["others", 96.865, 97.207], ["a", 97.665, 97.99], ["wake", 98.248, 98.457], ["them", 98.457, 98.69], ["b", 98.982, 99.357], ["let", 99.582, 99.723], ["them", 99.723, 99.84], ["sleep", 99.84, 100.215], ["follow", 100.557, 101.023], ["if", 101.023, 101.123], ["you'd", 101.123, 101.282], ["pull", 101.282, 101.498], ["for", 101.498, 101.615], ["someone", 101.615, 101.923], ["you", 101.923, 102.032], ["love", 102.032, 102.54]], "lines": [[0.0, 3.183, "In this town, whoever pulls the sword out of the stone becomes king."], [3.508, 5.408, "Nobody has done it in a thousand years."], [5.767, 7.733, "I'm Rowan, and I didn't pull out the sword."], [7.942, 9.308, "I pulled out the whole stone."], [9.758, 12.108, "This year, the king made every grown-up try."], [12.392, 14.183, "If you failed, you went to his quarry."], [14.525, 16.6, "When it was my dad's turn, I went instead."], [17.067, 18.85, "I pulled. The sword didn't move."], [19.167, 20.125, "But the ground did."], [20.442, 22.15, "The square cracked like an eggshell."], [22.542, 24.158, "And the stone opened its eyes."], [24.483, 25.633, "It was a giant's head."], [25.9, 27.408, "The sword was stuck in his crown."], [27.692, 29.333, "He stood up, taller than the castle."], [29.833, 30.792, "Then he bowed to me."], [31.283, 32.75, "The prince once made the sword wiggle."], [33.008, 33.933, "He still talks about it."], [34.25, 35.75, "Today, he didn't say a word."], [36.15, 39.538, "The king yelled, \"That doesn't count! You pulled out a head!\""], [39.879, 41.562, "I said, \"Call it a head start.\""], [41.921, 43.813, "So the giant pulled out the sword himself."], [44.088, 44.888, "He handed it to me."], [45.138, 46.828, "The king screamed, \"Seize him!\""], [47.195, 49.237, "Every guard in the square knelt instead."], [49.562, 51.32, "The giant picked up the king by his cape."], [51.57, 53.978, "He set him on the bell tower, like a cat on a fridge."], [54.362, 57.003, "For twenty years, Dad paid a gold coin to try."], [57.345, 58.512, "Every year, he lost."], [58.787, 62.03, "He always said, \"If I win, you'll never be hungry again.\""], [62.397, 64.088, "The whole town called him the Coin Man."], [64.522, 66.597, "The giant lifted the castle roof like a lid."], [66.863, 68.18, "He shook out the king's gold."], [68.43, 70.722, "Exactly twenty coins rolled to Dad's feet."], [71.105, 72.447, "Then the giant knelt to Dad."], [72.838, 76.131, "\"Twenty years,\" he said. \"I felt every pull.\""], [76.614, 79.554, "\"You never pulled to be king. You pulled for your son.\""], [79.996, 81.986, "\"Today, your son pulled for you.\""], [82.427, 86.132, "\"In a thousand years, you're the only two who pulled for someone else.\""], [86.566, 87.382, "Dad couldn't talk."], [87.641, 88.358, "He just hugged me."], [88.632, 90.274, "He was crying. The good kind."], [90.641, 92.191, "Then the giant looked at the mountains."], [92.541, 94.724, "\"There are four more swords,\" he said."], [94.998, 96.056, "\"I was the smallest.\""], [96.365, 100.215, "Do we wake the others? A, wake them. B, let them sleep."], [100.557, 102.54, "Follow if you'd pull for someone you love."]]}