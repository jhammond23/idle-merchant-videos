d", 67.153, 67.461], ["its", 67.461, 67.594], ["face", 67.594, 67.969], ["the", 68.244, 68.311], ["king", 68.311, 68.569], ["whispered", 68.569, 68.927], ["that", 69.237, 69.382], ["curtain", 69.382, 69.714], ["wasn't", 69.714, 69.987], ["for", 69.987, 70.098], ["you", 70.098, 70.397], ["it", 70.669, 70.763], ["was", 70.763, 70.917], ["for", 70.917, 71.019], ["him", 71.019, 71.42], ["one", 71.911, 72.219], ["giant", 72.219, 72.661], ["eye", 72.661, 72.936], ["started", 72.936, 73.286], ["to", 73.286, 73.353], ["open", 73.353, 73.752], ["do", 74.086, 74.178], ["we", 74.178, 74.278], ["hang", 74.278, 74.453], ["the", 74.453, 74.519], ["curtain", 74.519, 74.786], ["back", 74.786, 74.978], ["up", 74.978, 75.211], ["a", 75.786, 76.102], ["hang", 76.411, 76.636], ["it", 76.636, 76.819], ["b", 77.119, 77.511], ["let", 77.719, 77.861], ["him", 77.861, 77.977], ["wake", 77.977, 78.278], ["follow", 78.594, 79.011], ["if", 79.011, 79.128], ["you'd", 79.128, 79.252], ["have", 79.252, 79.336], ["pulled", 79.336, 79.561], ["the", 79.561, 79.619], ["thread", 79.619, 80.136]], "lines": [[0.0, 2.258, "In this town, the king sells the sunlight."], [2.475, 4.833, "If you can't pay, he hangs a curtain over your street."], [5.292, 7.025, "My street has been dark for six years."], [7.433, 9.9, "I'm Fold, and I pulled the whole curtain down."], [10.367, 13.5, "My little sister Nell planted one sunflower, and it wouldn't open."], [13.925, 17.017, "So I climbed our roof with a broom, and poked one hole in the curtain."], [17.383, 19.458, "One sunbeam landed right on her flower."], [19.817, 21.133, "It opened like a yawn."], [21.567, 24.167, "A gold thread came loose from the hole, and Nell grabbed it."], [24.408, 25.533, "I said, \"Don't pull that.\""], [25.867, 27.25, "Then the baker held up a spoon."], [27.483, 29.483, "The light bounced to the next house, and the next."], [29.733, 31.533, "Spoons, pans, a tuba."], [31.825, 33.742, "One sunbeam went down the whole street."], [34.05, 35.425, "The king saw it from his castle."], [35.692, 38.025, "He said, \"Patch that hole, and charge them triple.\""], [38.4, 40.767, "His men climbed up with needles as long as spears."], [41.158, 43.55, "I could poke more holes, but they'd patch every one."], [43.883, 45.975, "So I grabbed the gold thread, and I ran."], [46.3, 49.175, "The curtain came apart behind me, row by row, like a sweater."], [49.367, 51.167, "Sunlight poured into every window."], [51.475, 54.283, "People came outside and just stood there, with their eyes closed."], [54.717, 56.908, "Nell's sunflower turned its head to watch me run."], [57.175, 58.995, "The king yelled, \"That's my sun!\""], [59.303, 61.102, "I said, \"You can't sell the sky.\""], [61.453, 62.961, "Then the last of the curtain fell."], [63.311, 66.261, "And behind it, on the mountain, something huge was asleep."], [66.644, 67.969, "The sunlight touched its face."], [68.244, 71.42, "The king whispered, \"That curtain wasn't for you. It was for him.\""], [71.911, 73.752, "One giant eye started to open."], [74.086, 78.278, "Do we hang the curtain back up? A, hang it. B, let him wake."], [78.594, 80.136, "Follow if you'd have pulled the thread."]]}