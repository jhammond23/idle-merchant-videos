13], ["his", 122.213, 122.321], ["knees", 122.321, 122.691], ["my", 122.881, 122.981], ["legs", 122.981, 123.251], ["turned", 123.251, 123.459], ["back", 123.459, 123.605], ["to", 123.605, 123.698], ["normal", 123.698, 124.091], ["i", 124.259, 124.351], ["won", 124.351, 124.798], ["i", 124.999, 125.099], ["actually", 125.099, 125.461], ["won", 125.461, 125.915], ["far", 126.173, 126.404], ["below", 126.404, 126.604], ["the", 126.604, 126.658], ["window", 126.658, 127.051], ["i", 127.213, 127.298], ["could", 127.298, 127.421], ["see", 127.421, 127.614], ["our", 127.614, 127.722], ["farm", 127.722, 128.13], ["the", 128.307, 128.376], ["candle", 128.376, 128.738], ["in", 128.738, 128.831], ["dad's", 128.831, 129.085], ["window", 129.085, 129.401], ["was", 129.401, 129.517], ["still", 129.517, 129.755], ["lit", 129.755, 130.048], ["my", 130.252, 130.345], ["sister", 130.345, 130.638], ["was", 130.638, 130.753], ["still", 130.753, 130.93], ["sitting", 130.93, 131.169], ["on", 131.169, 131.254], ["the", 131.254, 131.308], ["fence", 131.308, 131.701], ["waiting", 131.878, 132.256], ["then", 132.429, 132.63], ["the", 132.63, 132.699], ["thief", 132.699, 132.976], ["started", 132.976, 133.284], ["laughing", 133.284, 133.754], ["you", 133.984, 134.076], ["think", 134.076, 134.307], ["i'm", 134.307, 134.531], ["the", 134.531, 134.6], ["worst", 134.6, 134.87], ["thing", 134.87, 135.016], ["in", 135.016, 135.085], ["this", 135.085, 135.232], ["castle", 135.232, 135.64], ["the", 135.815, 135.907], ["torches", 135.907, 136.239], ["above", 136.239, 136.493], ["us", 136.493, 136.609], ["went", 136.609, 136.786], ["out", 136.786, 137.048], ["one", 137.218, 137.588], ["by", 137.827, 138.344], ["one", 138.57, 138.893], ["then", 139.137, 139.276], ["the", 139.276, 139.345], ["doors", 139.345, 139.615], ["upstairs", 139.615, 140.008], ["started", 140.008, 140.27], ["slamming", 140.27, 140.709], ["open", 140.709, 141.017], ["bang", 141.205, 141.597], ["bang", 141.798, 142.206], ["bang", 142.383, 142.807], ["sixty", 142.989, 143.49], ["eighty", 143.676, 144.015], ["one", 144.231, 144.385], ["hundred", 144.385, 144.839], ["something", 145.021, 145.337], ["was", 145.337, 145.452], ["coming", 145.452, 145.653], ["down", 145.653, 145.815], ["the", 145.815, 145.868], ["stairs", 145.868, 146.315], ["i", 146.521, 146.583], ["couldn't", 146.583, 146.783], ["see", 146.783, 146.937], ["a", 146.937, 146.968], ["face", 146.968, 147.369], ["only", 147.553, 147.823], ["a", 147.823, 147.892], ["golden", 147.892, 148.331], ["crown", 148.331, 148.809], ["glowing", 148.979, 149.356], ["in", 149.356, 149.425], ["the", 149.425, 149.495], ["dark", 149.495, 149.865], ["the", 150.026, 150.195], ["wish", 150.195, 150.573], ["is", 150.573, 150.796], ["mine", 150.796, 151.459], ["it", 151.682, 151.798], ["said", 151.798, 152.137], ["the", 152.312, 152.381], ["key", 152.381, 152.612], ["thief", 152.612, 152.859], ["was", 152.859, 153.005], ["never", 153.005, 153.29], ["the", 153.29, 153.367], ["boss", 153.367, 153.637], ["of", 153.637, 153.714], ["this", 153.714, 153.852], ["castle", 153.852, 154.253], ["he", 154.403, 154.488], ["was", 154.488, 154.634], ["just", 154.634, 154.804], ["the", 154.804, 154.873], ["king's", 154.873, 155.181], ["guard", 155.181, 155.489], ["dog", 155.489, 155.982]], "lines": [[0.0, 2.789, "In this town, there's a castle on the hill with a hundred doors."], [2.976, 6.245, "Behind every door is a trial. Pass it, and the next door opens."], [6.454, 9.618, "And whoever opens door one hundred gets one wish. Any wish."], [9.831, 11.841, "But there's one rule nobody says out loud."], [12.055, 17.49, "If you fail a trial, nothing hurts. You just turn to stone. Crack! One more statue in the castle garden."], [17.678, 19.072, "And some of them still look surprised."], [19.274, 21.416, "That's why the garden gets a little more crowded every year."], [21.746, 26.359, "My dad has been stuck in bed since the first snow. The healers say no potion in the kingdom can fix him."], [26.576, 28.294, "But any wish means any wish."], [28.571, 33.809, "So the morning I turned eleven, I packed half a loaf of bread, grabbed Dad's old wooden sword, and walked up the hill."], [34.023, 37.898, "My little sister held my hand at the gate. \"You can do this. For Dad,\" she said."], [38.119, 40.334, "Then the gate slammed shut behind me. Boom!"], [40.674, 43.825, "Door one was a bridge of floating stones over a hole with no bottom."], [44.045, 49.474, "Every stone sank the second you stood on it. Bad news, because I have never stood still in my life. Just ask my teacher."], [49.677, 52.482, "I hopped. I slipped. I almost fell, but I made it."], [52.717, 55.074, "A bell rang. \"Gift earned. Feather Step.\""], [55.4, 59.808, "Door seven was worse. A suit of armor the size of a barn woke up and chased me through a maze."], [59.972, 61.359, "Clank. Clank. Clank."], [61.596, 66.379, "I ran faster than I'd ever run. Even faster than when my sister yells, \"Last one home does the dishes!\""], [66.574, 68.583, "Ding! \"Gift earned. Swift.\""], [68.865, 71.985, "I kept going. Door thirty. Door forty-one. Door forty-nine."], [72.235, 75.342, "Then came door fifty, and someone was already there. Waiting."], [75.559, 79.041, "He wore a black cloak covered in hundreds of tiny keys, all jingling."], [79.257, 83.811, "\"Another climber!\" he laughed. \"I'm the Key Thief. I don't pass trials. I skip them.\""], [84.059, 87.017, "He turned a golden key in the air, and the floor under me opened."], [87.179, 89.339, "Feather Step! I floated right over the hole."], [89.527, 92.377, "Then he unlocked a door in thin air and stepped out behind me."], [92.522, 95.798, "But this time, I was faster. Swift! I was already behind him."], [95.967, 98.125, "He turned the key one last time. \"Lock.\""], [98.398, 100.998, "My feet went cold and gray. I was turning to stone."], [101.215, 104.259, "I thought about my sister at the gate. You can do this. For Dad."], [104.546, 105.448, "That's when I understood."], [105.657, 109.162, "He never opened a single door the real way. He never passed one trial."], [109.323, 112.483, "So he never earned one real gift. All he had was that key."], [112.746, 115.003, "My legs were stone, but my arms still worked."], [115.191, 118.109, "Giant Grip! I grabbed that golden key and snapped it in half."], [118.302, 122.691, "Crack! Every key on his cloak crumbled to dust. The thief screamed and dropped to his knees."], [122.881, 125.915, "My legs turned back to normal. I won! I actually won!"], [126.173, 132.256, "Far below the window, I could see our farm. The candle in Dad's window was still lit. My sister was still sitting on the fence, waiting."], [132.429, 135.64, "Then the thief started laughing. \"You think I'm the worst thing in this castle?\""], [135.815, 138.893, "The torches above us went out. One. By. One."], [139.137, 142.807, "Then the doors upstairs started slamming open. Bang. Bang. Bang."], [142.989, 144.839, "Sixty. Eighty. One hundred."], [145.021, 149.865, "Something was coming down the stairs. I couldn't see a face. Only a golden crown, glowing in the dark."], [150.026, 152.137, "\"The wish is mine,\" it said."], [152.312, 155.982, "The Key Thief was never the boss of this castle. He was just the king's guard dog."]]}